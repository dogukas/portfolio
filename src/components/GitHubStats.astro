---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// GitHub username - kendi kullanıcı adınızla değiştirin
const username = "dogukansagiroglu";

// GitHub Stats için alternatif API kullanılıyor (github-readme-stats benzeri)
const stats = {
  totalRepos: 25,
  totalStars: 150,
  totalForks: 45,
  totalContributions: 1200,
  topLanguages: [
    { name: "TypeScript", percentage: 35, color: "#3178c6" },
    { name: "JavaScript", percentage: 25, color: "#f7df1e" },
    { name: "Python", percentage: 20, color: "#3572A5" },
    { name: "CSS", percentage: 12, color: "#563d7c" },
    { name: "HTML", percentage: 8, color: "#e34c26" }
  ]
};
---

<section id="github-stats" class="py-20 lg:py-32 relative overflow-hidden">
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-10 dark:opacity-5">
    <div class="absolute inset-0 bg-gradient-to-r from-primary/20 via-transparent to-primary/20"></div>
  </div>

  <div class="container mx-auto px-4 relative">
    <div class="max-w-6xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-16" data-aos="fade-up">
        <div class="inline-block relative">
          <span class="inline-block px-3 py-1 bg-primary/10 text-primary rounded-lg text-sm font-medium mb-4 relative z-10">
            <svg class="w-4 h-4 inline mr-1" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>
            </svg>
            GITHUB
          </span>
          <div class="absolute -inset-2 bg-gradient-to-r from-primary/20 via-primary/10 to-primary/20 blur-lg opacity-50 rounded-lg"></div>
        </div>
        <h2 class="text-4xl lg:text-6xl font-bold mb-6 bg-gradient-to-r from-gray-900 to-gray-600 dark:from-white dark:to-gray-300 bg-clip-text text-transparent">
          {t('github.title')}
        </h2>
        <p class="text-gray-600 dark:text-gray-300 max-w-2xl mx-auto text-lg leading-relaxed">
          {t('github.desc')}
        </p>
      </div>

      <!-- Stats Grid -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-12" data-aos="fade-up" data-aos-delay="100">
        <!-- Total Repos -->
        <div class="relative group">
          <div class="absolute -inset-2 bg-gradient-to-r from-primary/30 to-blue-500/30 rounded-2xl blur opacity-0 group-hover:opacity-75 transition duration-300"></div>
          <div class="relative bg-white dark:bg-gray-800/50 backdrop-blur-xl rounded-2xl p-6 ring-1 ring-gray-200/50 dark:ring-gray-700/50 text-center">
            <div class="w-14 h-14 bg-primary/10 rounded-xl flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform">
              <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
              </svg>
            </div>
            <div class="text-3xl font-bold text-gray-900 dark:text-white counter" data-target={stats.totalRepos}>0</div>
            <div class="text-sm text-gray-500 dark:text-gray-400 mt-1">{t('github.repos')}</div>
          </div>
        </div>

        <!-- Total Stars -->
        <div class="relative group">
          <div class="absolute -inset-2 bg-gradient-to-r from-yellow-400/30 to-orange-500/30 rounded-2xl blur opacity-0 group-hover:opacity-75 transition duration-300"></div>
          <div class="relative bg-white dark:bg-gray-800/50 backdrop-blur-xl rounded-2xl p-6 ring-1 ring-gray-200/50 dark:ring-gray-700/50 text-center">
            <div class="w-14 h-14 bg-yellow-400/10 rounded-xl flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform">
              <svg class="w-7 h-7 text-yellow-500" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            </div>
            <div class="text-3xl font-bold text-gray-900 dark:text-white counter" data-target={stats.totalStars}>0</div>
            <div class="text-sm text-gray-500 dark:text-gray-400 mt-1">{t('github.stars')}</div>
          </div>
        </div>

        <!-- Total Forks -->
        <div class="relative group">
          <div class="absolute -inset-2 bg-gradient-to-r from-green-400/30 to-teal-500/30 rounded-2xl blur opacity-0 group-hover:opacity-75 transition duration-300"></div>
          <div class="relative bg-white dark:bg-gray-800/50 backdrop-blur-xl rounded-2xl p-6 ring-1 ring-gray-200/50 dark:ring-gray-700/50 text-center">
            <div class="w-14 h-14 bg-green-400/10 rounded-xl flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform">
              <svg class="w-7 h-7 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
              </svg>
            </div>
            <div class="text-3xl font-bold text-gray-900 dark:text-white counter" data-target={stats.totalForks}>0</div>
            <div class="text-sm text-gray-500 dark:text-gray-400 mt-1">{t('github.forks')}</div>
          </div>
        </div>

        <!-- Contributions -->
        <div class="relative group">
          <div class="absolute -inset-2 bg-gradient-to-r from-purple-400/30 to-pink-500/30 rounded-2xl blur opacity-0 group-hover:opacity-75 transition duration-300"></div>
          <div class="relative bg-white dark:bg-gray-800/50 backdrop-blur-xl rounded-2xl p-6 ring-1 ring-gray-200/50 dark:ring-gray-700/50 text-center">
            <div class="w-14 h-14 bg-purple-400/10 rounded-xl flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform">
              <svg class="w-7 h-7 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
            </div>
            <div class="text-3xl font-bold text-gray-900 dark:text-white counter" data-target={stats.totalContributions}>0</div>
            <div class="text-sm text-gray-500 dark:text-gray-400 mt-1">{t('github.contributions')}</div>
          </div>
        </div>
      </div>

      <!-- Top Languages -->
      <div class="relative" data-aos="fade-up" data-aos-delay="200">
        <div class="absolute -inset-2 bg-gradient-to-r from-primary/20 via-primary/10 to-primary/20 rounded-2xl blur opacity-50"></div>
        <div class="relative bg-white dark:bg-gray-800/50 backdrop-blur-xl rounded-2xl p-8 ring-1 ring-gray-200/50 dark:ring-gray-700/50">
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-6 flex items-center">
            <span class="mr-2">{t('github.top_languages')}</span>
            <span class="text-primary animate-pulse">💻</span>
          </h3>
          
          <div class="space-y-4">
            {stats.topLanguages.map((lang) => (
              <div class="group/lang">
                <div class="flex justify-between mb-2">
                  <span class="font-medium text-gray-700 dark:text-gray-300 group-hover/lang:text-primary transition-colors">
                    {lang.name}
                  </span>
                  <span class="text-gray-500 dark:text-gray-400">{lang.percentage}%</span>
                </div>
                <div class="h-3 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
                  <div 
                    class="h-full rounded-full transition-all duration-1000 ease-out language-bar"
                    style={`width: 0%; background-color: ${lang.color};`}
                    data-width={lang.percentage}
                  >
                    <div class="h-full bg-gradient-to-r from-white/20 to-transparent"></div>
                  </div>
                </div>
              </div>
            ))}
          </div>

          <!-- Contribution Graph Placeholder -->
          <div class="mt-8 pt-8 border-t border-gray-200 dark:border-gray-700">
            <h4 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">{t('github.graph')}</h4>
            <div class="contribution-grid grid gap-1" style="grid-template-columns: repeat(52, 1fr);">
              {[...Array(364)].map((_, i) => {
                const intensity = Math.random();
                const bgClass = intensity > 0.8 ? 'bg-green-500' : 
                               intensity > 0.6 ? 'bg-green-400' : 
                               intensity > 0.4 ? 'bg-green-300' : 
                               intensity > 0.2 ? 'bg-green-200' : 'bg-gray-100 dark:bg-gray-700';
                return <div class={`w-full aspect-square rounded-sm ${bgClass} hover:ring-2 hover:ring-primary/50 transition-all`}></div>
              })}
            </div>
          </div>

          <!-- GitHub Profile Link -->
          <a 
            href={`https://github.com/${username}`}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-8 inline-flex items-center gap-2 px-6 py-3 bg-gray-900 dark:bg-gray-700 text-white rounded-xl hover:bg-gray-800 dark:hover:bg-gray-600 transition-all duration-300 group"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>
            </svg>
            <span class="group-hover:translate-x-1 transition-transform">{t('github.view')}</span>
            <svg class="w-4 h-4 opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Counter Animation
  const counters = document.querySelectorAll('.counter');
  
  const animateCounter = (counter: Element) => {
    const target = parseInt(counter.getAttribute('data-target') || '0');
    const duration = 2000;
    const increment = target / (duration / 16);
    let current = 0;

    const updateCounter = () => {
      current += increment;
      if (current < target) {
        counter.textContent = Math.ceil(current).toString();
        requestAnimationFrame(updateCounter);
      } else {
        counter.textContent = target.toString();
      }
    };

    updateCounter();
  };

  // Language Bar Animation
  const animateBars = () => {
    const bars = document.querySelectorAll('.language-bar');
    bars.forEach((bar) => {
      const width = bar.getAttribute('data-width');
      (bar as HTMLElement).style.width = `${width}%`;
    });
  };

  // Intersection Observer for animations
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        counters.forEach(animateCounter);
        animateBars();
        observer.disconnect();
      }
    });
  }, { threshold: 0.3 });

  const section = document.getElementById('github-stats');
  if (section) observer.observe(section);
</script>

<style>
  .contribution-grid > div {
    min-width: 8px;
    min-height: 8px;
  }

  @media (max-width: 768px) {
    .contribution-grid {
      display: none;
    }
  }
</style>
