---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { data } from '../i18n/data';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { projects } = data[lang];
---

<section id="projects" class="py-20 lg:py-32 relative overflow-hidden">
  <!-- Arkaplan Deseni -->
  <div class="absolute inset-0 opacity-10 dark:opacity-5">
    <div class="absolute inset-0 bg-gradient-to-r from-primary/20 via-transparent to-primary/20"></div>
    <div class="absolute inset-y-0 left-0 w-1/2 bg-gradient-to-r from-primary/10 to-transparent"></div>
    <div class="absolute inset-y-0 right-0 w-1/2 bg-gradient-to-l from-primary/10 to-transparent"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(var(--color-primary-rgb),0.1)_0%,transparent_100%)]"></div>
  </div>

  <div class="container mx-auto px-4 relative">
    <div class="max-w-6xl mx-auto">
      <!-- Başlık -->
      <div class="text-center mb-16" data-aos="fade-up">
        <div class="inline-block relative">
          <span class="inline-block px-3 py-1 bg-primary/10 text-primary rounded-lg text-sm font-medium mb-4 relative z-10">
            PROJELER
          </span>
          <div class="absolute -inset-2 bg-gradient-to-r from-primary/20 via-primary/10 to-primary/20 blur-lg opacity-50 rounded-lg"></div>
        </div>
        <h2 class="text-4xl lg:text-6xl font-bold mb-6 bg-gradient-to-r from-gray-900 to-gray-600 dark:from-white dark:to-gray-300 bg-clip-text text-transparent">
          Öne Çıkan <span class="text-primary">Projeler</span>
        </h2>
        <p class="text-gray-600 dark:text-gray-300 max-w-2xl mx-auto text-lg leading-relaxed">
          Modern teknolojiler kullanarak geliştirdiğim bazı projeler
        </p>
      </div>

      <!-- Projeler -->
      <div class="grid lg:grid-cols-2 gap-8">
        {projects.map((project, index) => (
          <div 
            class="group relative bg-white dark:bg-gray-800/50 backdrop-blur-xl rounded-2xl overflow-hidden ring-1 ring-gray-200/50 dark:ring-gray-700/50"
            data-aos={index % 2 === 0 ? "fade-right" : "fade-left"}
          >
            <!-- Proje Görseli -->
            <div class="relative h-64 overflow-hidden">
              <div class="absolute inset-0 bg-gradient-to-b from-transparent to-black/50 z-10"></div>
              <img 
                src={project.image} 
                alt={project.title}
                class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-500"
              />
              <!-- Live Preview Overlay -->
              <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center z-20">
                <div class="transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
                  <a href={project.demoUrl} target="_blank" class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-white rounded-full hover:bg-primary-dark transition-colors transform hover:scale-105">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span>Canlı Önizleme</span>
                  </a>
                </div>
              </div>
              <!-- Etiketler -->
              <div class="absolute bottom-4 left-4 right-4 z-20 flex flex-wrap gap-2">
                {project.tags.map(tag => (
                  <span class="px-3 py-1 bg-white/10 backdrop-blur-md rounded-full text-xs font-medium text-white">
                    {tag}
                  </span>
                ))}
              </div>
            </div>

            <!-- Proje Detayları -->
            <div class="p-6">
              <h3 class="text-2xl font-bold mb-3 bg-gradient-to-r from-gray-900 to-gray-600 dark:from-white dark:to-gray-300 bg-clip-text text-transparent">
                {project.title}
              </h3>
              <p class="text-gray-600 dark:text-gray-300 mb-6">
                {project.description}
              </p>

              <!-- Özellikler -->
              <div class="mb-6">
                <h4 class="text-sm font-semibold text-gray-900 dark:text-gray-100 mb-3">Öne Çıkan Özellikler:</h4>
                <ul class="space-y-2">
                  {project.features.map(feature => (
                    <li class="flex items-center text-gray-600 dark:text-gray-300">
                      <svg class="w-4 h-4 text-primary mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                      </svg>
                      {feature}
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Butonlar -->
              <div class="flex gap-4">
                <a 
                  href={project.demoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 inline-flex items-center justify-center px-4 py-2 border border-transparent rounded-lg text-sm font-medium text-white bg-primary hover:bg-primary-dark transition-colors"
                >
                  <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                  </svg>
                  Demo
                </a>
                <a 
                  href={project.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 inline-flex items-center justify-center px-4 py-2 border-2 border-primary rounded-lg text-sm font-medium text-primary hover:bg-primary hover:text-white transition-colors"
                >
                  <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
                    <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path>
                  </svg>
                  GitHub
                </a>
              </div>
            </div>

            <!-- Hover Efekti -->
            <div class="absolute -inset-2 bg-gradient-to-r from-primary/30 via-primary/20 to-primary/30 rounded-2xl blur opacity-0 group-hover:opacity-75 transition duration-300"></div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes tiltHover {
    0% {
      transform: perspective(1000px) rotateX(0) rotateY(0);
    }
    50% {
      transform: perspective(1000px) rotateX(2deg) rotateY(2deg);
    }
    100% {
      transform: perspective(1000px) rotateX(0) rotateY(0);
    }
  }

  @keyframes float {
    0% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
    100% {
      transform: translateY(0);
    }
  }

  @keyframes gradientMove {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }

  .project-card {
    transform-style: preserve-3d;
    perspective: 1000px;
    transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .project-card:hover {
    transform: translateY(-5px);
    animation: tiltHover 5s infinite ease-in-out;
  }

  .project-image {
    transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .project-card:hover .project-image {
    transform: scale(1.1) translateZ(20px);
  }

  .tag {
    animation: float 6s infinite ease-in-out;
    animation-delay: calc(var(--tag-index) * 0.1s);
  }

  .project-gradient {
    background: linear-gradient(
      120deg,
      rgba(var(--color-primary-rgb), 0.2),
      rgba(var(--color-primary-rgb), 0.1),
      rgba(var(--color-primary-rgb), 0.2)
    );
    background-size: 200% 200%;
    animation: gradientMove 15s infinite linear;
  }

  .button-hover {
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .button-hover:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px -10px rgba(var(--color-primary-rgb), 0.5);
  }

  .icon-spin {
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .button-hover:hover .icon-spin {
    transform: rotate(360deg);
  }
</style> 