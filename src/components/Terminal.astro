---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { data } from '../i18n/data';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { terminal: commands } = data[lang];
---

<section id="terminal" class="py-20 lg:py-32 relative overflow-hidden">
  <!-- Background -->
  <div class="absolute inset-0 opacity-10 dark:opacity-5">
    <div class="absolute inset-0 bg-gradient-to-r from-primary/20 via-transparent to-primary/20"></div>
  </div>

  <div class="container mx-auto px-4 relative">
    <div class="max-w-4xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-16" data-aos="fade-up">
        <div class="inline-block relative">
          <span class="inline-block px-3 py-1 bg-primary/10 text-primary rounded-lg text-sm font-medium mb-4 relative z-10">
            💻 {t('terminal.title').toUpperCase()}
          </span>
          <div class="absolute -inset-2 bg-gradient-to-r from-primary/20 via-primary/10 to-primary/20 blur-lg opacity-50 rounded-lg"></div>
        </div>
        <h2 class="text-4xl lg:text-6xl font-bold mb-6 bg-gradient-to-r from-gray-900 to-gray-600 dark:from-white dark:to-gray-300 bg-clip-text text-transparent">
          {t('terminal.title')}
        </h2>
        <p class="text-gray-600 dark:text-gray-300 max-w-2xl mx-auto text-lg leading-relaxed">
          {t('terminal.desc')} <code class="bg-gray-100 dark:bg-gray-800 px-2 py-1 rounded">help</code>
        </p>
      </div>

      <!-- Terminal Window -->
      <div class="relative" data-aos="fade-up" data-aos-delay="200">
        <div class="absolute -inset-2 bg-gradient-to-r from-primary/30 via-blue-500/30 to-purple-500/30 rounded-2xl blur opacity-50"></div>
        <div class="relative bg-gray-900 rounded-2xl overflow-hidden shadow-2xl border border-gray-700">
          <!-- Terminal Header -->
          <div class="flex items-center gap-2 px-4 py-3 bg-gray-800 border-b border-gray-700">
            <div class="flex gap-2">
              <div class="w-3 h-3 rounded-full bg-red-500"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
              <div class="w-3 h-3 rounded-full bg-green-500"></div>
            </div>
            <span class="ml-4 text-gray-400 text-sm font-mono">doğukan@portfolio ~ </span>
          </div>

          <!-- Terminal Body -->
          <div id="terminal-output" class="p-6 font-mono text-sm text-gray-300 h-96 overflow-y-auto">
            <div class="mb-4">
              <span class="text-green-400">▶</span> 
              <span class="text-gray-400">Portfolyo Terminal v1.0.0</span>
            </div>
            <div class="mb-4">
              <span class="text-gray-400">Hoş geldiniz! Başlamak için </span>
              <span class="text-primary">'help'</span>
              <span class="text-gray-400"> yazın.</span>
            </div>
          </div>

          <!-- Terminal Input -->
          <div class="flex items-center gap-2 px-6 py-4 bg-gray-800/50 border-t border-gray-700">
            <span class="text-green-400 font-mono">❯</span>
            <input 
              type="text" 
              id="terminal-input"
              class="flex-1 bg-transparent border-none outline-none text-gray-100 font-mono placeholder-gray-500"
              placeholder="Komut yazın..."
              autocomplete="off"
              spellcheck="false"
            />
            <button id="execute-btn" class="px-4 py-1.5 bg-primary text-white text-sm rounded-lg hover:bg-primary/80 transition-colors">
              Çalıştır
            </button>
          </div>
        </div>
      </div>

      <!-- Quick Commands -->
      <div class="flex flex-wrap gap-2 justify-center mt-6" data-aos="fade-up" data-aos-delay="300">
        <span class="text-gray-500 dark:text-gray-400 text-sm mr-2">Hızlı komutlar:</span>
        {Object.keys(commands).filter(cmd => cmd !== 'help').map((cmd) => (
          <button 
            class="quick-cmd px-3 py-1 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-lg text-sm hover:bg-primary hover:text-white transition-colors"
            data-cmd={cmd}
          >
            {cmd}
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<script define:vars={{ commands }}>
  const input = document.getElementById('terminal-input');
  const output = document.getElementById('terminal-output');
  const executeBtn = document.getElementById('execute-btn');
  const quickCmds = document.querySelectorAll('.quick-cmd');

  const commandHistory = [];
  let historyIndex = -1;

  function appendOutput(content, isCommand = false) {
    const div = document.createElement('div');
    div.className = 'mb-4 ' + (isCommand ? 'text-gray-100' : '');
    
    if (isCommand) {
      div.innerHTML = `<span class="text-green-400">❯</span> ${content}`;
    } else {
      div.innerHTML = `<pre class="whitespace-pre-wrap">${content}</pre>`;
    }
    
    output.appendChild(div);
    output.scrollTop = output.scrollHeight;
  }

  function executeCommand(cmd) {
    const trimmedCmd = cmd.trim().toLowerCase();
    
    if (!trimmedCmd) return;
    
    // Add to history
    commandHistory.push(trimmedCmd);
    historyIndex = commandHistory.length;
    
    // Show command
    appendOutput(trimmedCmd, true);
    
    // Handle commands
    if (trimmedCmd === 'clear') {
      output.innerHTML = '';
      appendOutput('<span class="text-gray-400">Terminal temizlendi.</span>');
    } else if (commands[trimmedCmd]) {
      appendOutput(commands[trimmedCmd]);
    } else {
      appendOutput(`<span class="text-red-400">Komut bulunamadı: '${trimmedCmd}'</span>\n<span class="text-gray-400">Mevcut komutları görmek için 'help' yazın.</span>`);
    }
    
    // Clear input
    input.value = '';
  }

  // Event Listeners
  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      executeCommand(input.value);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (historyIndex > 0) {
        historyIndex--;
        input.value = commandHistory[historyIndex];
      }
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (historyIndex < commandHistory.length - 1) {
        historyIndex++;
        input.value = commandHistory[historyIndex];
      } else {
        historyIndex = commandHistory.length;
        input.value = '';
      }
    }
  });

  executeBtn?.addEventListener('click', () => {
    if (input) executeCommand(input.value);
  });

  quickCmds.forEach((btn) => {
    btn.addEventListener('click', () => {
      const cmd = btn.getAttribute('data-cmd');
      if (cmd && input) {
        input.value = cmd;
        executeCommand(cmd);
      }
    });
  });

  // Auto-focus on terminal click
  document.querySelector('#terminal-output')?.addEventListener('click', () => {
    input?.focus();
  });
</script>

<style>
  #terminal-output::-webkit-scrollbar {
    width: 8px;
  }

  #terminal-output::-webkit-scrollbar-track {
    background: #1f2937;
  }

  #terminal-output::-webkit-scrollbar-thumb {
    background: #4b5563;
    border-radius: 4px;
  }

  #terminal-output::-webkit-scrollbar-thumb:hover {
    background: #6b7280;
  }

  #terminal-input:focus {
    outline: none;
  }

  pre {
    font-family: 'Fira Code', 'Monaco', 'Consolas', monospace;
  }
</style>
