---
// Kullanılabilirlik durumu - true: müsait, false: meşgul
const isAvailable = true;
const statusText = isAvailable ? "Proje Alıyor" : "Şu An Meşgul";
const statusColor = isAvailable ? "green" : "orange";
---

<div class="availability-badge group relative">
  <div class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm border border-gray-200 dark:border-gray-700 shadow-sm hover:shadow-md transition-all duration-300 cursor-pointer">
    <!-- Animated Pulse Dot -->
    <div class="relative">
      <span class={`absolute inset-0 rounded-full ${isAvailable ? 'bg-green-400' : 'bg-orange-400'} animate-ping opacity-75`}></span>
      <span class={`relative block w-2.5 h-2.5 rounded-full ${isAvailable ? 'bg-green-500' : 'bg-orange-500'}`}></span>
    </div>
    
    <!-- Status Text -->
    <span class="text-xs font-medium text-gray-700 dark:text-gray-300 whitespace-nowrap">
      {statusText}
    </span>
  </div>

  <!-- Hover Tooltip -->
  <div class="absolute top-full left-1/2 -translate-x-1/2 mt-2 px-3 py-2 bg-gray-900 dark:bg-gray-700 text-white text-xs rounded-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 whitespace-nowrap z-50 shadow-xl">
    <div class="absolute -top-1 left-1/2 -translate-x-1/2 w-2 h-2 bg-gray-900 dark:bg-gray-700 rotate-45"></div>
    {isAvailable ? (
      <span class="flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
        Yeni projeler için müsaidim!
      </span>
    ) : (
      <span class="flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        Şu an yoğun, yakında müsait olacağım
      </span>
    )}
  </div>
</div>

<style>
  .availability-badge {
    user-select: none;
  }

  @keyframes ping {
    75%, 100% {
      transform: scale(2);
      opacity: 0;
    }
  }

  .animate-ping {
    animation: ping 1.5s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
</style>
