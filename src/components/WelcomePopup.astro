---
// WelcomePopup.astro
// Siteye girildiğinde açılan karşılama ekranı
// 3D fotoğraf + Spotify widget + "Başlayalım" butonu

const GITHUB_USERNAME = "dogukansagiroglu";
const PHOTO_URL = `https://github.com/${GITHUB_USERNAME}.png?size=400`;

const SPOTIFY_TRACK_ID = "2pwED7E7gGr3UR7T3s3LSM";
const SPOTIFY_EMBED_URL = `https://open.spotify.com/embed/track/${SPOTIFY_TRACK_ID}?utm_source=generator&theme=0&autoplay=1`;
---

<!-- Full-screen Welcome Popup Overlay -->
<div
  id="welcome-popup"
  class="fixed inset-0 z-[10000] flex items-center justify-center bg-black/80 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
>
  <!-- Animated background gradient -->
  <div class="absolute inset-0 bg-gradient-to-br from-gray-950 via-gray-900 to-gray-950 pointer-events-none">
    <div class="absolute inset-0 opacity-30 bg-[radial-gradient(ellipse_at_top_left,rgba(59,130,246,0.3),transparent_50%),radial-gradient(ellipse_at_bottom_right,rgba(139,92,246,0.3),transparent_50%)]"></div>
    <!-- Animated orbs -->
    <div class="absolute top-1/4 left-1/4 w-64 h-64 bg-primary/20 rounded-full blur-3xl animate-pulse"></div>
    <div class="absolute bottom-1/4 right-1/4 w-64 h-64 bg-purple-500/20 rounded-full blur-3xl animate-pulse" style="animation-delay:1s;"></div>
  </div>

  <!-- Popup Card -->
  <div
    id="welcome-card"
    class="relative flex flex-col items-center gap-6 px-6 py-10 sm:px-10 w-full max-w-md mx-4 rounded-3xl border border-white/10 bg-white/5 backdrop-blur-xl shadow-2xl overflow-hidden"
    style="animation: popupEnter 0.6s cubic-bezier(0.34,1.56,0.64,1) both;"
  >
    <!-- Greeting badge -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-primary/20 border border-primary/30 rounded-full text-primary text-xs font-semibold tracking-wide uppercase">
      <span class="w-2 h-2 bg-primary rounded-full animate-ping"></span>
      Hoş geldiniz
    </div>

    <!-- 3D Profile Photo Container -->
    <div
      id="popup-photo-wrap"
      class="relative cursor-grab active:cursor-grabbing"
      style="perspective: 800px;"
    >
      <!-- Glowing ring -->
      <div class="absolute inset-0 rounded-full bg-gradient-to-br from-primary via-purple-500 to-pink-500 blur-md opacity-70 scale-110"></div>
      <!-- Photo -->
      <div
        id="popup-photo-inner"
        class="relative w-36 h-36 sm:w-44 sm:h-44 rounded-full overflow-hidden border-4 border-white/20 shadow-2xl"
        style="transform-style: preserve-3d; transition: transform 0.1s ease-out;"
      >
        <img
          src={PHOTO_URL}
          alt="Doğukan Tevfik Sağıroğlu"
          class="w-full h-full object-cover"
          crossorigin="anonymous"
        />
        <!-- Shine overlay -->
        <div class="absolute inset-0 bg-gradient-to-br from-white/20 via-transparent to-transparent pointer-events-none rounded-full"></div>
      </div>
    </div>

    <!-- Name & Title -->
    <div class="text-center">
      <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">Doğukan Tevfik</h2>
      <p class="text-gray-400 text-sm mt-1 font-mono">Full Stack Developer & DevOps</p>
    </div>

    <!-- Spotify Embed -->
    <div class="w-full rounded-2xl overflow-hidden shadow-xl border border-white/10" style="min-height: 80px;">
      <iframe
        id="welcome-spotify-iframe"
        src={SPOTIFY_EMBED_URL}
        width="100%"
        height="80"
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        style="border-radius: 16px;"
        loading="eager"
      ></iframe>
    </div>

    <!-- CTA Button -->
    <button
      id="welcome-enter-btn"
      class="group relative w-full py-4 bg-gradient-to-r from-primary to-purple-600 text-white font-bold text-lg rounded-2xl shadow-lg shadow-primary/30 hover:shadow-primary/50 hover:scale-105 active:scale-95 transition-all duration-300 overflow-hidden"
    >
      <!-- Button shine animation -->
      <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-700"></div>
      <span class="relative flex items-center justify-center gap-3">
        <!-- Play icon -->
        <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"/>
        </svg>
        Başlayalım
      </span>
    </button>

    <!-- Skip link -->
    <button id="welcome-skip-btn" class="text-gray-600 hover:text-gray-400 text-xs transition-colors">
      Geç →
    </button>
  </div>
</div>

<script>
  function initWelcomePopup() {
    const popup = document.getElementById('welcome-popup') as HTMLElement;
    const photoInner = document.getElementById('popup-photo-inner') as HTMLElement;
    const photoWrap = document.getElementById('popup-photo-wrap') as HTMLElement;
    const enterBtn = document.getElementById('welcome-enter-btn');
    const skipBtn = document.getElementById('welcome-skip-btn');

    if (!popup) return;

    // ==== 3D Parallax on Photo ====
    if (photoWrap && photoInner) {
      photoWrap.addEventListener('mousemove', (e) => {
        const rect = photoWrap.getBoundingClientRect();
        const cx = rect.left + rect.width / 2;
        const cy = rect.top + rect.height / 2;
        const dx = (e.clientX - cx) / (rect.width / 2);
        const dy = (e.clientY - cy) / (rect.height / 2);
        photoInner.style.transform = `rotateY(${dx * 20}deg) rotateX(${-dy * 20}deg) scale(1.05)`;
      });

      photoWrap.addEventListener('mouseleave', () => {
        photoInner.style.transform = 'rotateY(0deg) rotateX(0deg) scale(1)';
        photoInner.style.transition = 'transform 0.5s ease-out';
      });

      // Auto subtle float animation
      let t = 0;
      const float = () => {
        t += 0.02;
        if (!photoWrap.matches(':hover')) {
          photoInner.style.transform = `rotateY(${Math.sin(t) * 5}deg) rotateX(${Math.cos(t) * 3}deg)`;
          photoInner.style.transition = 'none';
        }
        requestAnimationFrame(float);
      };
      float();
    }

    // ==== Close Popup with animation ====
    const dismiss = () => {
      popup.style.opacity = '0';
      popup.style.transform = 'scale(1.05)';
      popup.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
      setTimeout(() => {
        popup.style.display = 'none';
        document.body.style.overflow = '';
      }, 500);
    };

    enterBtn?.addEventListener('click', dismiss);
    skipBtn?.addEventListener('click', dismiss);

    // Block body scroll while open
    document.body.style.overflow = 'hidden';
  }

  initWelcomePopup();
  document.addEventListener('astro:page-load', initWelcomePopup);
</script>

<style>
  @keyframes popupEnter {
    from {
      opacity: 0;
      transform: scale(0.8) translateY(40px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }
</style>
