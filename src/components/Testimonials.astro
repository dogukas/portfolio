---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { data } from '../i18n/data';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { testimonials } = data[lang];
---

<section id="testimonials" class="py-20 lg:py-32 relative overflow-hidden">
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-10 dark:opacity-5">
    <div class="absolute inset-0 bg-gradient-to-r from-primary/20 via-transparent to-primary/20"></div>
    <div class="absolute inset-y-0 left-0 w-1/2 bg-gradient-to-r from-primary/10 to-transparent"></div>
    <div class="absolute inset-y-0 right-0 w-1/2 bg-gradient-to-l from-primary/10 to-transparent"></div>
  </div>

  <div class="container mx-auto px-4 relative">
    <div class="max-w-6xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-16" data-aos="fade-up">
        <div class="inline-block relative">
          <span class="inline-block px-3 py-1 bg-primary/10 text-primary rounded-lg text-sm font-medium mb-4 relative z-10">
            {t('testimonials.title').toUpperCase()}
          </span>
          <div class="absolute -inset-2 bg-gradient-to-r from-primary/20 via-primary/10 to-primary/20 blur-lg opacity-50 rounded-lg"></div>
        </div>
        <h2 class="text-4xl lg:text-6xl font-bold mb-6 bg-gradient-to-r from-gray-900 to-gray-600 dark:from-white dark:to-gray-300 bg-clip-text text-transparent">
          {t('testimonials.title')}
        </h2>
        <p class="text-gray-600 dark:text-gray-300 max-w-2xl mx-auto text-lg leading-relaxed">
          {t('testimonials.desc')}
        </p>
      </div>

      <!-- Testimonials Carousel -->
      <div class="relative" data-aos="fade-up" data-aos-delay="200">
        <!-- Carousel Container -->
        <div class="overflow-hidden rounded-2xl">
          <div id="testimonials-track" class="flex transition-transform duration-500 ease-out">
            {testimonials.map((testimonial) => (
              <div class="w-full md:w-1/2 flex-shrink-0 px-4">
                <div class="relative group h-full">
                  <div class="absolute -inset-2 bg-gradient-to-r from-primary/30 via-primary/20 to-primary/30 rounded-2xl blur opacity-0 group-hover:opacity-75 transition duration-300"></div>
                  <div class="relative bg-white dark:bg-gray-800/50 backdrop-blur-xl rounded-2xl p-8 ring-1 ring-gray-200/50 dark:ring-gray-700/50 h-full flex flex-col">
                    <!-- Quote Icon -->
                    <div class="absolute -top-4 -left-4 w-12 h-12 bg-primary rounded-full flex items-center justify-center shadow-lg shadow-primary/20">
                      <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
                      </svg>
                    </div>

                    <!-- Rating Stars -->
                    <div class="flex gap-1 mb-4">
                      {[...Array(testimonial.rating)].map(() => (
                        <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                        </svg>
                      ))}
                    </div>

                    <!-- Content -->
                    <p class="text-gray-600 dark:text-gray-300 leading-relaxed flex-grow italic">
                      "{testimonial.content}"
                    </p>

                    <!-- Author -->
                    <div class="flex items-center mt-6 pt-6 border-t border-gray-200 dark:border-gray-700">
                      <img 
                        src={testimonial.avatar} 
                        alt={testimonial.name}
                        class="w-14 h-14 rounded-full ring-2 ring-primary/20 mr-4"
                      />
                      <div>
                        <h4 class="font-semibold text-gray-900 dark:text-white">{testimonial.name}</h4>
                        <p class="text-sm text-gray-500 dark:text-gray-400">{testimonial.role} @ {testimonial.company}</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Navigation Arrows -->
        <button 
          id="prev-btn"
          class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-4 w-12 h-12 bg-white dark:bg-gray-800 rounded-full shadow-lg flex items-center justify-center text-gray-600 dark:text-gray-300 hover:text-primary hover:scale-110 transition-all duration-300 z-10"
          aria-label="Previous"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>
        <button 
          id="next-btn"
          class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-4 w-12 h-12 bg-white dark:bg-gray-800 rounded-full shadow-lg flex items-center justify-center text-gray-600 dark:text-gray-300 hover:text-primary hover:scale-110 transition-all duration-300 z-10"
          aria-label="Next"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </button>

        <!-- Dots Navigation -->
        <div id="dots-container" class="flex justify-center gap-2 mt-8">
          {testimonials.map((_, index) => (
            <button 
              class={`dot w-3 h-3 rounded-full transition-all duration-300 ${index === 0 ? 'bg-primary w-8' : 'bg-gray-300 dark:bg-gray-600 hover:bg-primary/50'}`}
              data-index={index}
              aria-label={`Go to slide ${index + 1}`}
            ></button>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const track = document.getElementById('testimonials-track');
  const prevBtn = document.getElementById('prev-btn');
  const nextBtn = document.getElementById('next-btn');
  const dots = document.querySelectorAll('.dot');
  
  let currentIndex = 0;
  const totalSlides = dots.length;
  let slidesPerView = window.innerWidth >= 768 ? 2 : 1;
  let autoPlayInterval: ReturnType<typeof setInterval>;

  function updateSlider() {
    if (track) {
      const slideWidth = 100 / slidesPerView;
      track.style.transform = `translateX(-${currentIndex * slideWidth}%)`;
    }
    
    dots.forEach((dot, index) => {
      if (index === currentIndex) {
        dot.classList.add('bg-primary', 'w-8');
        dot.classList.remove('bg-gray-300', 'dark:bg-gray-600');
      } else {
        dot.classList.remove('bg-primary', 'w-8');
        dot.classList.add('bg-gray-300', 'dark:bg-gray-600');
      }
    });
  }

  function nextSlide() {
    const maxIndex = Math.max(0, totalSlides - slidesPerView);
    currentIndex = currentIndex >= maxIndex ? 0 : currentIndex + 1;
    updateSlider();
  }

  function prevSlide() {
    const maxIndex = Math.max(0, totalSlides - slidesPerView);
    currentIndex = currentIndex <= 0 ? maxIndex : currentIndex - 1;
    updateSlider();
  }

  function startAutoPlay() {
    autoPlayInterval = setInterval(nextSlide, 5000);
  }

  function stopAutoPlay() {
    clearInterval(autoPlayInterval);
  }

  // Event Listeners
  nextBtn?.addEventListener('click', () => {
    stopAutoPlay();
    nextSlide();
    startAutoPlay();
  });

  prevBtn?.addEventListener('click', () => {
    stopAutoPlay();
    prevSlide();
    startAutoPlay();
  });

  dots.forEach((dot, index) => {
    dot.addEventListener('click', () => {
      stopAutoPlay();
      currentIndex = index;
      updateSlider();
      startAutoPlay();
    });
  });

  // Responsive
  window.addEventListener('resize', () => {
    slidesPerView = window.innerWidth >= 768 ? 2 : 1;
    updateSlider();
  });

  // Pause on hover
  track?.addEventListener('mouseenter', stopAutoPlay);
  track?.addEventListener('mouseleave', startAutoPlay);

  // Initialize
  startAutoPlay();
</script>

<style>
  #testimonials-track > div {
    min-height: 100%;
  }

  .dot {
    cursor: pointer;
  }
</style>
