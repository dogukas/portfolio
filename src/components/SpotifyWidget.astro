---
// SpotifyWidget.astro
// Ekranın sağ alt köşesinde yüzen, gizlenebilir Spotify mini player
// Değiştirmek için aşağıdaki SPOTIFY_TRACK_URI değerini güncelleyin.
// Spotify'da bir şarkıya sağ tıklayın → "Parça Bağlantısını Kopyala"
// URL'deki son kısım sizin track ID'nizdir.
// Örnek: https://open.spotify.com/track/0VjIjW4GlUZAMYd2vXMi3b -> 0VjIjW4GlUZAMYd2vXMi3b

// ↓↓↓ BURAYA KENDİ ŞARKI ID'NİZİ YAZIN ↓↓↓
const SPOTIFY_TRACK_ID = "2pwED7E7gGr3UR7T3s3LSM"; // Kullanıcının seçtiği şarkı
const SPOTIFY_EMBED_URL = `https://open.spotify.com/embed/track/${SPOTIFY_TRACK_ID}?utm_source=generator&theme=0&autoplay=1`;
---

<!-- Floating Spotify Mini Player -->
<div id="spotify-float-widget" class="fixed bottom-6 right-6 z-[9998] flex flex-col items-end gap-2">

  <!-- Toggle Button -->
  <button
    id="spotify-toggle-btn"
    class="flex items-center gap-2 pl-4 pr-5 py-2.5 bg-gray-900 text-green-400 rounded-full shadow-xl border border-gray-700 hover:border-green-500/50 hover:shadow-green-500/20 hover:shadow-lg transition-all duration-300 group"
    aria-label="Spotify Player'ı aç/kapat"
  >
    <!-- Spotify Logo -->
    <svg class="w-5 h-5 text-green-500 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
    </svg>
    <!-- Equalizer animation bars -->
    <div class="flex items-end gap-0.5 h-4" id="eq-bars">
      <span class="w-0.5 h-2 bg-green-500 rounded-full eq-bar"></span>
      <span class="w-0.5 h-3.5 bg-green-500 rounded-full eq-bar"></span>
      <span class="w-0.5 h-1.5 bg-green-500 rounded-full eq-bar"></span>
      <span class="w-0.5 h-4 bg-green-500 rounded-full eq-bar"></span>
    </div>
    <span class="text-xs font-semibold tracking-wide text-gray-200 group-hover:text-white transition-colors">Müzik</span>
  </button>

  <!-- Spotify Embed iframe container -->
  <div
    id="spotify-player-panel"
    class="overflow-hidden transition-all duration-500 rounded-2xl shadow-2xl border border-gray-700/50 hidden"
    style="width: 320px; max-height: 0; opacity: 0;"
  >
    <iframe
      id="spotify-iframe"
      src={SPOTIFY_EMBED_URL}
      width="100%"
      height="152"
      frameborder="0"
      allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
      style="border-radius: 16px;"
    ></iframe>
  </div>
</div>

<script>
  function initSpotifyWidget() {
    const toggleBtn = document.getElementById('spotify-toggle-btn');
    const panel = document.getElementById('spotify-player-panel') as HTMLElement;

    if (!toggleBtn || !panel) return;

    let isOpen = true;

    const openPlayer = () => {
      panel.classList.remove('hidden');
      requestAnimationFrame(() => {
        panel.style.maxHeight = '200px';
        panel.style.opacity = '1';
      });
      isOpen = true;
    };

    const closePlayer = () => {
      panel.style.maxHeight = '0';
      panel.style.opacity = '0';
      setTimeout(() => panel.classList.add('hidden'), 500);
      isOpen = false;
    };

    toggleBtn.addEventListener('click', () => {
      if (isOpen) closePlayer();
      else openPlayer();
    });

    // Auto-open immediately on every page load
    openPlayer();
  }

  initSpotifyWidget();
  document.addEventListener('astro:page-load', initSpotifyWidget);
</script>

<style>
  @keyframes eq1 {
    0%, 100% { height: 8px; }
    50% { height: 3px; }
  }
  @keyframes eq2 {
    0%, 100% { height: 14px; }
    50% { height: 6px; }
  }
  @keyframes eq3 {
    0%, 100% { height: 6px; }
    50% { height: 14px; }
  }
  @keyframes eq4 {
    0%, 100% { height: 16px; }
    50% { height: 4px; }
  }

  .eq-bar:nth-child(1) { animation: eq1 0.8s ease-in-out infinite; }
  .eq-bar:nth-child(2) { animation: eq2 0.6s ease-in-out infinite 0.1s; }
  .eq-bar:nth-child(3) { animation: eq3 0.7s ease-in-out infinite 0.2s; }
  .eq-bar:nth-child(4) { animation: eq4 0.5s ease-in-out infinite 0.3s; }

  #spotify-player-panel {
    transition: max-height 0.5s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.4s ease;
  }
</style>
