---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { data } from '../i18n/data';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { about } = data[lang];
const { stats } = about;

const skills = [
  { name: "Web Geliştirme", level: "95%", color: "from-blue-500 to-indigo-500" },
  { name: "UI/UX Tasarım", level: "90%", color: "from-purple-500 to-pink-500" },
  { name: "Mobil Uygulama", level: "85%", color: "from-green-500 to-teal-500" },
  { name: "Veritabanı Yönetimi", level: "88%", color: "from-orange-500 to-red-500" }
];

const technologies = [
  { name: "JavaScript", icon: "devicon-javascript-plain", color: "text-yellow-500" },
  { name: "React", icon: "devicon-react-original", color: "text-blue-500" },
  { name: "Node.js", icon: "devicon-nodejs-plain", color: "text-green-600" },
  { name: "TypeScript", icon: "devicon-typescript-plain", color: "text-blue-600" },
  { name: "Python", icon: "devicon-python-plain", color: "text-blue-500" },
  { name: "Docker", icon: "devicon-docker-plain", color: "text-blue-400" }
];
---

<section id="about" class="py-20 lg:py-32 relative overflow-hidden">
  <!-- Arkaplan Deseni -->
  <div class="absolute inset-0 opacity-10 dark:opacity-5">
    <div class="absolute inset-0 bg-gradient-to-r from-primary/20 via-transparent to-primary/20"></div>
    <div class="absolute inset-y-0 left-0 w-1/2 bg-gradient-to-r from-primary/10 to-transparent"></div>
    <div class="absolute inset-y-0 right-0 w-1/2 bg-gradient-to-l from-primary/10 to-transparent"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(var(--color-primary-rgb),0.1)_0%,transparent_100%)]"></div>
  </div>

  <div class="container mx-auto px-4 relative">
    <div class="max-w-6xl mx-auto">
      <!-- Başlık -->
      <div class="text-center mb-16" data-aos="fade-up">
        <div class="inline-block relative">
          <span class="inline-block px-3 py-1 bg-primary/10 text-primary rounded-lg text-sm font-medium mb-4 relative z-10">
            HAKKIMDA
          </span>
          <div class="absolute -inset-2 bg-gradient-to-r from-primary/20 via-primary/10 to-primary/20 blur-lg opacity-50 rounded-lg"></div>
        </div>
        <h2 class="text-4xl lg:text-6xl font-bold mb-6 bg-gradient-to-r from-gray-900 to-gray-600 dark:from-white dark:to-gray-300 bg-clip-text text-transparent">
          Profesyonel <span class="text-primary">Yolculuğum</span>
        </h2>
        <p class="text-gray-600 dark:text-gray-300 max-w-2xl mx-auto text-lg leading-relaxed">
          Dijital dünyada yaratıcı | kurumsal çözümler üreten tutkulu bir geliştirici | DevOps
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-12 items-start">
        <!-- Sol Kısım: Hakkımda Metni -->
        <div class="space-y-8" data-aos="fade-right">
          <div class="bg-white dark:bg-gray-800/50 backdrop-blur-xl rounded-2xl p-8 shadow-lg hover:shadow-xl transition-all duration-300 group border border-gray-100 dark:border-gray-700/50">
            <div class="prose prose-lg max-w-none dark:prose-invert">
              {about.bio.map((paragraph, index) => (
                <p class={`text-gray-600 dark:text-gray-300 leading-relaxed group-hover:transform group-hover:translate-x-2 transition-transform duration-300 ${index > 0 ? 'mt-4' : ''}`}>
                  {paragraph}
                </p>
              ))}
            </div>

            <!-- İstatistikler -->
            <div class="grid grid-cols-2 gap-6 mt-8">
              {stats.map(stat => (
                <div class="group/stat relative">
                  <div class="absolute -inset-1 bg-gradient-to-r from-primary/50 to-primary/30 rounded-xl blur opacity-25 group-hover/stat:opacity-50 transition duration-300"></div>
                  <div class="relative bg-white dark:bg-gray-800 rounded-xl p-6 ring-1 ring-gray-200/50 dark:ring-gray-700/50">
                    <div class="text-4xl mb-2 transform group-hover/stat:scale-110 transition-transform duration-300">{stat.icon}</div>
                    <div class="text-3xl font-bold bg-gradient-to-r from-primary to-primary-dark bg-clip-text text-transparent">{stat.number}</div>
                    <div class="text-gray-600 dark:text-gray-300 text-sm font-medium mt-1">{stat.text}</div>
                    <div class="mt-2 text-xs text-gray-500 dark:text-gray-400 opacity-0 group-hover/stat:opacity-100 transition-all duration-300">
                      {stat.description}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Sağ Kısım: Yetenekler -->
        <div class="space-y-8" data-aos="fade-left" data-aos-delay="200">
          <div class="bg-white dark:bg-gray-800/50 backdrop-blur-xl rounded-2xl p-8 shadow-lg hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-gray-700/50">
            <h3 class="text-2xl font-bold mb-6 flex items-center">
              <span class="mr-2">Yeteneklerim</span>
              <span class="text-primary animate-pulse">⚡</span>
            </h3>
            <div class="space-y-6">
              {skills.map(skill => (
                <div class="group/skill">
                  <div class="flex justify-between mb-2">
                    <span class="text-gray-700 dark:text-gray-300 font-medium group-hover/skill:text-primary transition-colors duration-300">{skill.name}</span>
                    <span class="text-primary font-medium opacity-0 group-hover/skill:opacity-100 transition-all duration-300 transform translate-y-2 group-hover/skill:translate-y-0">{skill.level}</span>
                  </div>
                  <div class="h-2 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden relative">
                    <div class="absolute inset-0 bg-gradient-to-r from-primary/20 to-primary/10 animate-pulse"></div>
                    <div 
                      class={`h-full bg-gradient-to-r ${skill.color} rounded-full transition-all duration-1000 transform origin-left scale-x-0 group-hover/skill:scale-x-100 relative z-10`}
                      style={`width: ${skill.level};`}
                    >
                      <div class="absolute inset-0 bg-gradient-to-r from-white/20 to-transparent animate-shimmer"></div>
                    </div>
                  </div>
                </div>
              ))}
            </div>

            <!-- Teknoloji Yığını -->
            <div class="mt-12">
              <h3 class="text-2xl font-bold mb-6 flex items-center">
                <span class="mr-2">Teknoloji Yığınım</span>
                <span class="text-primary animate-bounce">🛠️</span>
              </h3>
              <div class="grid grid-cols-3 gap-4">
                {technologies.map(tech => (
                  <div class="group/tech relative">
                    <div class="absolute -inset-2 bg-gradient-to-r from-primary/30 to-primary/10 rounded-xl blur opacity-0 group-hover/tech:opacity-75 transition duration-300"></div>
                    <div class="relative bg-white dark:bg-gray-800 rounded-xl p-4 flex flex-col items-center justify-center ring-1 ring-gray-200/50 dark:ring-gray-700/50">
                      <i class={`${tech.icon} text-3xl ${tech.color} group-hover/tech:scale-125 transition-all duration-300`}></i>
                      <span class="text-sm mt-2 opacity-0 group-hover/tech:opacity-100 transition-all duration-300">{tech.name}</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- İnteraktif CTA -->
            <div class="mt-12 relative group/cta">
              <div class="absolute -inset-2 bg-gradient-to-r from-primary/30 via-primary/20 to-primary/30 rounded-xl blur-xl opacity-0 group-hover/cta:opacity-75 transition duration-300"></div>
              <a href="#contact" class="relative block bg-white dark:bg-gray-800 p-6 rounded-xl ring-1 ring-gray-200/50 dark:ring-gray-700/50 hover:ring-primary/50 transition-all duration-300">
                <div class="flex items-center justify-between">
                  <div>
                    <h4 class="text-lg font-semibold bg-gradient-to-r from-gray-900 to-gray-600 dark:from-white dark:to-gray-300 bg-clip-text text-transparent">Birlikte Çalışalım!</h4>
                    <p class="text-gray-600 dark:text-gray-400 text-sm mt-1">Projenizi hayata geçirmek için iletişime geçin</p>
                  </div>
                  <div class="text-primary text-2xl transform group-hover/cta:translate-x-2 transition-transform duration-300">→</div>
                </div>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes shimmer {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100%);
    }
  }

  .animate-shimmer {
    animation: shimmer 2s infinite;
  }

  .tech-card {
    @apply relative flex flex-col items-center justify-center p-4 bg-gray-50 dark:bg-gray-700/50 rounded-xl 
           transform hover:-translate-y-1 transition-all duration-300 cursor-pointer overflow-hidden;
  }

  /* DevIcon CDN */
  @import url('https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css');
</style>

<!-- Sayfa başına eklenecek -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css"> 