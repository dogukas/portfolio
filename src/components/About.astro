---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { data } from '../i18n/data';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { about } = data[lang];
const { stats } = about;

const experiences = [
  {
    role: "Senior Full Stack Geliştirici",
    company: "Örnek Teknoloji A.Ş.",
    date: "2022 - Günümüz",
    description: "Modern web uygulamalarının uçtan uca mimarisini tasarlıyorum. Sürekli entegrasyon süreçlerini yönetiyor ve performans metriklerini üst düzeye çıkarıyorum."
  },
  {
    role: "Frontend Geliştirici",
    company: "Dijital Ajans",
    date: "2020 - 2022",
    description: "Yüksek performanslı, PWA odaklı ve kusursuz kullanıcı deneyimi (UI/UX) hedefleyen kurumsal web projelerini React ve modern CSS çatısı ile hayata geçirdim."
  },
  {
    role: "Yazılım Mühendisliği",
    company: "XYZ Üniversitesi",
    date: "2016 - 2020",
    description: "Algoritma tasarımı, veri yapıları ve modern yazılım mimarisi üzerine sağlam bir temel. Birçok araştırma projesinde aktif görev aldım."
  }
];
---

<section id="about" class="py-20 lg:py-32 relative overflow-hidden">
  <!-- Arkaplan Deseni -->
  <div class="absolute inset-0 opacity-10 dark:opacity-5">
    <div class="absolute inset-0 bg-gradient-to-r from-primary/20 via-transparent to-primary/20"></div>
    <div class="absolute inset-y-0 left-0 w-1/2 bg-gradient-to-r from-primary/10 to-transparent"></div>
    <div class="absolute inset-y-0 right-0 w-1/2 bg-gradient-to-l from-primary/10 to-transparent"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(var(--color-primary-rgb),0.1)_0%,transparent_100%)]"></div>
  </div>

  <div class="container mx-auto px-4 relative">
    <div class="max-w-6xl mx-auto">
      <!-- Başlık -->
      <div class="text-center mb-16" data-aos="fade-up">
        <div class="inline-block relative">
          <span class="inline-block px-3 py-1 bg-primary/10 text-primary rounded-lg text-sm font-medium mb-4 relative z-10">
            HAKKIMDA
          </span>
          <div class="absolute -inset-2 bg-gradient-to-r from-primary/20 via-primary/10 to-primary/20 blur-lg opacity-50 rounded-lg"></div>
        </div>
        <h2 class="text-4xl lg:text-6xl font-bold mb-6 bg-gradient-to-r from-gray-900 to-gray-600 dark:from-white dark:to-gray-300 bg-clip-text text-transparent">
          Profesyonel <span class="text-primary">Yolculuğum</span>
        </h2>
        <p class="text-gray-600 dark:text-gray-300 max-w-2xl mx-auto text-lg leading-relaxed">
          Dijital dünyada yaratıcı | kurumsal çözümler üreten tutkulu bir geliştirici | DevOps
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-12 items-start">
        <!-- Sol Kısım: Hakkımda Metni -->
        <div class="space-y-8" data-aos="fade-right">
          <div class="bg-white dark:bg-gray-800/50 backdrop-blur-xl rounded-2xl p-8 shadow-lg hover:shadow-xl transition-all duration-300 group border border-gray-100 dark:border-gray-700/50">
            <div class="prose prose-lg max-w-none dark:prose-invert">
              {about.bio.map((paragraph, index) => (
                <p class={`text-gray-600 dark:text-gray-300 leading-relaxed group-hover:transform group-hover:translate-x-2 transition-transform duration-300 ${index > 0 ? 'mt-4' : ''}`}>
                  {paragraph}
                </p>
              ))}
            </div>

            <!-- İstatistikler -->
            <div class="grid grid-cols-2 gap-6 mt-8">
              {stats.map(stat => (
                <div class="group/stat relative">
                  <div class="absolute -inset-1 bg-gradient-to-r from-primary/50 to-primary/30 rounded-xl blur opacity-25 group-hover/stat:opacity-50 transition duration-300"></div>
                  <div class="relative bg-white dark:bg-gray-800 rounded-xl p-6 ring-1 ring-gray-200/50 dark:ring-gray-700/50">
                    <div class="text-4xl mb-2 transform group-hover/stat:scale-110 transition-transform duration-300">{stat.icon}</div>
                    <div class="text-3xl font-bold bg-gradient-to-r from-primary to-primary-dark bg-clip-text text-transparent">{stat.number}</div>
                    <div class="text-gray-600 dark:text-gray-300 text-sm font-medium mt-1">{stat.text}</div>
                    <div class="mt-2 text-xs text-gray-500 dark:text-gray-400 opacity-0 group-hover/stat:opacity-100 transition-all duration-300">
                      {stat.description}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Sağ Kısım: Deneyim Zaman Çizelgesi -->
        <div class="space-y-8" data-aos="fade-left" data-aos-delay="200">
          <div class="bg-white dark:bg-gray-800/50 backdrop-blur-xl rounded-2xl p-8 shadow-lg hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-gray-700/50">
            <h3 class="text-2xl font-bold mb-8 flex items-center">
              <span class="mr-2">Kariyer Yolculuğu</span>
              <span class="text-primary animate-bounce">🚀</span>
            </h3>
            
            <div class="relative border-l-2 border-primary/30 ml-3 space-y-10">
              {experiences.map((exp, index) => (
                <div class="relative pl-8 group/timeline">
                  <!-- Nokta -->
                  <div class="absolute w-4 h-4 rounded-full bg-primary -left-[9px] top-1.5 shadow-[0_0_10px_rgba(var(--color-primary-rgb),0.5)] group-hover/timeline:scale-125 transition-transform duration-300">
                    <div class="absolute inset-0 bg-primary/50 rounded-full animate-ping"></div>
                  </div>
                  
                  <div class="bg-gray-50 dark:bg-gray-800/80 rounded-xl p-5 border border-gray-200 dark:border-gray-700 group-hover/timeline:border-primary/50 transition-colors duration-300">
                    <div class="flex justify-between items-start mb-2">
                       <h4 class="text-lg font-bold text-gray-900 dark:text-gray-100 group-hover/timeline:text-primary transition-colors">{exp.role}</h4>
                       <span class="text-xs font-mono px-2 py-1 bg-primary/10 text-primary rounded-full whitespace-nowrap">{exp.date}</span>
                    </div>
                    <div class="text-sm font-semibold text-gray-500 dark:text-gray-400 mb-3">{exp.company}</div>
                    <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
                      {exp.description}
                    </p>
                  </div>
                </div>
              ))}
            </div>

            <!-- İnteraktif CTA -->
            <div class="mt-12 relative group/cta">
              <div class="absolute -inset-2 bg-gradient-to-r from-primary/30 via-primary/20 to-primary/30 rounded-xl blur-xl opacity-0 group-hover/cta:opacity-75 transition duration-300"></div>
              <a href="#projects" class="relative block bg-gradient-to-r from-primary to-primary-dark p-6 rounded-xl shadow-lg ring-1 ring-primary/20 transform hover:-translate-y-1 transition-all duration-300">
                <div class="flex items-center justify-between">
                  <div>
                    <h4 class="text-lg font-semibold text-white">Projelerimi İnceleyin</h4>
                    <p class="text-white/80 text-sm mt-1">Bu deneyimlerin hayata geçtiği çalışmaları görün</p>
                  </div>
                  <div class="text-white text-2xl transform group-hover/cta:translate-x-2 transition-transform duration-300">→</div>
                </div>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes shimmer {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100%);
    }
  }

  .animate-shimmer {
    animation: shimmer 2s infinite;
  }

  .tech-card {
    @apply relative flex flex-col items-center justify-center p-4 bg-gray-50 dark:bg-gray-700/50 rounded-xl 
           transform hover:-translate-y-1 transition-all duration-300 cursor-pointer overflow-hidden;
  }

  /* DevIcon CDN */
  @import url('https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css');
</style>

<!-- Sayfa başına eklenecek -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css"> 