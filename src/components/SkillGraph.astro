---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<div class="w-full h-[500px] relative bg-gray-50 dark:bg-gray-800/50 rounded-2xl overflow-hidden border border-gray-200 dark:border-gray-700 shadow-lg">
  <div class="absolute top-4 left-4 z-10 bg-white/80 dark:bg-gray-900/80 px-3 py-1 rounded-lg text-xs font-mono border border-gray-200 dark:border-gray-700">
    {t('skills.graph_help')}
  </div>
  <div id="sphere-container" class="w-full h-full relative cursor-grab active:cursor-grabbing overflow-hidden perspective-1000">
    <!-- 3D Elements injected via JS -->
  </div>
</div>

<script>
  // 3D Skill Sphere (Tag Cloud) Implementation using Fibonacci Sphere algorithm
  function initSkillSphere() {
    const container = document.getElementById('sphere-container');
    if (!container) return;

    // Remove any existing children (for HMR / View Transitions)
    while (container.firstChild) {
      container.removeChild(container.firstChild);
    }

    const skills = [
      'React', 'Vue', 'Astro', 'TypeScript', 'Tailwind', 'JavaScript', 'HTML5', 'CSS3',
      'Node.js', 'Python', 'PostgreSQL', 'MongoDB', 'Docker', 'AWS', 'Linux',
      'Git', 'GraphQL', 'Next.js', 'Redis', 'Figma', 'Jest', 'Redux', 'Express'
    ];

    const radius = container.clientWidth < 500 ? 120 : 180;
    const elements: HTMLElement[] = [];
    
    // Create the 3D sphere wrapper
    const sphere = document.createElement('div');
    sphere.style.position = 'absolute';
    sphere.style.top = '50%';
    sphere.style.left = '50%';
    sphere.style.width = '0';
    sphere.style.height = '0';
    sphere.style.transformStyle = 'preserve-3d';
    container.appendChild(sphere);

    // Fibonacci sphere distribution
    const phi = Math.PI * (3 - Math.sqrt(5));
    
    skills.forEach((skill, i) => {
      const el = document.createElement('div');
      el.textContent = skill;
      // Styling the tags
      el.className = 'absolute px-4 py-2 bg-white/80 dark:bg-gray-800/80 backdrop-blur-md rounded-full text-sm font-semibold border border-gray-200 dark:border-gray-700 shadow-sm hover:bg-primary hover:text-white dark:hover:bg-primary transition-colors cursor-pointer select-none whitespace-nowrap';
      
      // Calculate 3D position
      const y = 1 - (i / (skills.length - 1)) * 2;
      const radiusAtY = Math.sqrt(1 - y * y);
      const theta = phi * i;

      const x = Math.cos(theta) * radiusAtY;
      const z = Math.sin(theta) * radiusAtY;

      // Save base coordinates
      (el as any).baseX = x * radius;
      (el as any).baseY = y * radius;
      (el as any).baseZ = z * radius;

      // Apply initial transform centering the element relative to the sphere origin
      el.style.transform = `translate3d(${(el as any).baseX}px, ${(el as any).baseY}px, ${(el as any).baseZ}px) translate(-50%, -50%)`;
      
      sphere.appendChild(el);
      elements.push(el);
    });

    let targetRotationX = 0;
    let targetRotationY = 0;
    let mouseX = 0.003; // Default auto-rotate speed
    let mouseY = 0.003;

    const onMouseMove = (e: MouseEvent) => {
      const rect = container.getBoundingClientRect();
      const x = e.clientX - rect.left - rect.width / 2;
      const y = e.clientY - rect.top - rect.height / 2;
      
      // Calculate rotation speed based on mouse distance from center
      mouseX = x * 0.00005;
      mouseY = y * 0.00005;
    };

    container.addEventListener('mousemove', onMouseMove);
    container.addEventListener('mouseleave', () => {
      mouseX = 0.003;
      mouseY = 0.003;
    });

    // Touch support
    container.addEventListener('touchmove', (e) => {
      e.preventDefault();
      const touch = e.touches[0];
      const rect = container.getBoundingClientRect();
      const x = touch.clientX - rect.left - rect.width / 2;
      const y = touch.clientY - rect.top - rect.height / 2;
      mouseX = x * 0.0001;
      mouseY = y * 0.0001;
    }, { passive: false });

    container.addEventListener('touchend', () => {
      mouseX = 0.003;
      mouseY = 0.003;
    });

    let animationId: number;
    const animate = () => {
      targetRotationY += mouseX;
      targetRotationX += mouseY;

      sphere.style.transform = `rotateX(${-targetRotationX}rad) rotateY(${targetRotationY}rad)`;

      // Inverse rotation for the elements so text always faces the user
      elements.forEach(el => {
        el.style.transform = `translate3d(${(el as any).baseX}px, ${(el as any).baseY}px, ${(el as any).baseZ}px) translate(-50%, -50%) rotateY(${-targetRotationY}rad) rotateX(${targetRotationX}rad)`;
      });

      animationId = requestAnimationFrame(animate);
    };

    animate();

    // Cleanup for Astro ViewTransitions
    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(animationId);
      container.removeEventListener('mousemove', onMouseMove);
    }, { once: true });
  }

  initSkillSphere();
  document.addEventListener('astro:page-load', initSkillSphere);
</script>

<style>
  .perspective-1000 {
    perspective: 1000px;
  }
</style>
