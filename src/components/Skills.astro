---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { data } from '../i18n/data';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { skillsCategories: categories, softSkills } = data[lang];
---

<section id="skills" class="py-20 lg:py-32 relative overflow-hidden">
  <!-- Arkaplan Deseni -->
  <div class="absolute inset-0 opacity-10 dark:opacity-5">
    <div class="absolute inset-0 bg-gradient-to-r from-primary/20 via-transparent to-primary/20"></div>
    <div class="absolute inset-y-0 left-0 w-1/2 bg-gradient-to-r from-primary/10 to-transparent"></div>
    <div class="absolute inset-y-0 right-0 w-1/2 bg-gradient-to-l from-primary/10 to-transparent"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(var(--color-primary-rgb),0.1)_0%,transparent_100%)]"></div>
  </div>

  <div class="container mx-auto px-4 relative">
    <div class="max-w-6xl mx-auto">
      <!-- Başlık -->
      <div class="text-center mb-16" data-aos="fade-up">
        <div class="inline-block relative">
          <span class="inline-block px-3 py-1 bg-primary/10 text-primary rounded-lg text-sm font-medium mb-4 relative z-10">
            YETENEKLER
          </span>
          <div class="absolute -inset-2 bg-gradient-to-r from-primary/20 via-primary/10 to-primary/20 blur-lg opacity-50 rounded-lg"></div>
        </div>
        <h2 class="text-4xl lg:text-6xl font-bold mb-6 bg-gradient-to-r from-gray-900 to-gray-600 dark:from-white dark:to-gray-300 bg-clip-text text-transparent">
          Teknik <span class="text-primary">Uzmanlık</span>
        </h2>
        <p class="text-gray-600 dark:text-gray-300 max-w-2xl mx-auto text-lg leading-relaxed">
          Modern web teknolojileri ve yazılım geliştirme araçlarındaki yetkinliklerim
        </p>
      </div>

      <!-- Teknik Yetenekler -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
        {categories.map((category) => (
          <div class="relative group" data-aos="fade-up">
            <div class="absolute -inset-2 bg-gradient-to-r from-primary/30 via-primary/20 to-primary/30 rounded-2xl blur opacity-0 group-hover:opacity-75 transition duration-300"></div>
            <div class="relative bg-white dark:bg-gray-800/50 backdrop-blur-xl rounded-xl p-8 ring-1 ring-gray-200/50 dark:ring-gray-700/50">
              <!-- Kategori Başlığı -->
              <div class="flex items-center mb-6">
                <span class="text-2xl mr-3">{category.icon}</span>
                <h3 class="text-xl font-bold bg-gradient-to-r from-gray-900 to-gray-600 dark:from-white dark:to-gray-300 bg-clip-text text-transparent">
                  {category.title}
                </h3>
              </div>

              <!-- Yetenekler -->
              <div class="space-y-6">
                {category.skills.map((skill) => (
                  <div class="group/skill">
                    <div class="flex items-center justify-between mb-2">
                      <div class="flex items-center">
                        <i class={`${skill.icon} text-xl mr-2`}></i>
                        <span class="font-medium text-gray-700 dark:text-gray-300 group-hover/skill:text-primary transition-colors">
                          {skill.name}
                        </span>
                      </div>
                      <span class="text-primary font-medium opacity-0 group-hover/skill:opacity-100 transition-all">
                        {skill.level}%
                      </span>
                    </div>
                    <div class="h-2 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden relative">
                      <div class="absolute inset-0 bg-gradient-to-r from-primary/20 to-primary/10 animate-pulse"></div>
                      <div 
                        class={`h-full bg-gradient-to-r ${category.color} rounded-full transition-all duration-1000 transform origin-left scale-x-0 group-hover/skill:scale-x-100 relative z-10`}
                        style={`width: ${skill.level}%`}
                      >
                        <div class="absolute inset-0 bg-gradient-to-r from-white/20 to-transparent animate-shimmer"></div>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Soft Skills -->
      <div class="relative" data-aos="fade-up">
        <div class="absolute -inset-2 bg-gradient-to-r from-primary/30 via-primary/20 to-primary/30 rounded-2xl blur opacity-0 group-hover:opacity-75 transition duration-300"></div>
        <div class="relative bg-white dark:bg-gray-800/50 backdrop-blur-xl rounded-xl p-8 ring-1 ring-gray-200/50 dark:ring-gray-700/50">
          <h3 class="text-2xl font-bold mb-8 bg-gradient-to-r from-gray-900 to-gray-600 dark:from-white dark:to-gray-300 bg-clip-text text-transparent">
            Soft Skills
          </h3>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
            {softSkills.map((skill) => (
              <div class="relative group/soft">
                <div class="absolute inset-0 bg-gradient-to-r from-primary/10 to-primary/5 rounded-lg opacity-0 group-hover/soft:opacity-100 transition-opacity duration-300"></div>
                <div class="relative p-4 text-center">
                  <div class="text-3xl mb-2 transform group-hover/soft:scale-125 transition-transform duration-300">
                    {skill.icon}
                  </div>
                  <h4 class="font-medium text-gray-700 dark:text-gray-300 mb-2">{skill.name}</h4>
                  <div class="w-16 h-16 mx-auto relative">
                    <svg class="w-full h-full transform -rotate-90">
                      <circle
                        class="text-gray-200 dark:text-gray-700"
                        stroke-width="8"
                        stroke="currentColor"
                        fill="transparent"
                        r="26"
                        cx="32"
                        cy="32"
                      />
                      <circle
                        class="text-primary"
                        stroke-width="8"
                        stroke-linecap="round"
                        stroke="currentColor"
                        fill="transparent"
                        r="26"
                        cx="32"
                        cy="32"
                        style={`stroke-dasharray: ${2 * Math.PI * 26}; stroke-dashoffset: ${2 * Math.PI * 26 * (1 - skill.value / 100)}`}
                      />
                    </svg>
                    <span class="absolute inset-0 flex items-center justify-center text-sm font-medium text-primary">
                      {skill.value}%
                    </span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes shimmer {
    0% {
      transform: translateX(-100%) skewX(-15deg);
      opacity: 0;
    }
    50% {
      opacity: 0.5;
    }
    100% {
      transform: translateX(100%) skewX(-15deg);
      opacity: 0;
    }
  }

  @keyframes float {
    0% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-10px);
    }
    100% {
      transform: translateY(0px);
    }
  }

  @keyframes pulse {
    0% {
      transform: scale(1);
      opacity: 0.8;
    }
    50% {
      transform: scale(1.05);
      opacity: 0.6;
    }
    100% {
      transform: scale(1);
      opacity: 0.8;
    }
  }

  .animate-shimmer {
    animation: shimmer 3s infinite cubic-bezier(0.4, 0, 0.2, 1);
  }

  .group:hover .group-hover\:scale-x-100 {
    transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .skill-card {
    animation: float 6s infinite ease-in-out;
  }

  .skill-icon {
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .skill-icon:hover {
    transform: scale(1.2) rotate(5deg);
  }

  circle {
    transition: stroke-dashoffset 1.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .group-hover\:opacity-75 {
    transition: opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .group-hover\:translate-x-1 {
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .group-hover\:scale-110 {
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .bg-gradient-pulse {
    animation: pulse 4s infinite ease-in-out;
  }
</style>

<!-- Sayfa başına eklenecek -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css"> 