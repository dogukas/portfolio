---
import Availability from './Availability.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navItems = [
  { href: `/${lang}/#about`, text: t('nav.about'), icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
  </svg>` },
  { href: `/${lang}/#experience`, text: t('nav.experience'), icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
  </svg>` },
  { href: `/${lang}/#skills`, text: t('nav.skills'), icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
  </svg>` },
  { href: `/${lang}/#projects`, text: t('nav.projects'), icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
  </svg>` },
  { href: `/${lang}/blog`, text: t('nav.blog'), icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
  </svg>` },
  { href: `/${lang}/#contact`, text: t('nav.contact'), icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
  </svg>` }
];

const langPath = Astro.url.pathname.replace(/^\/(tr|de)/, '');
const languages = [
  { code: 'tr', name: 'Türkçe', flag: '🇹🇷', href: `/tr${langPath}` },
  { code: 'de', name: 'Deutsch', flag: '🇩🇪', href: `/de${langPath}` }
];
---

<div class="fixed top-0 left-0 right-0 z-50 px-4 py-6">
  <!-- Progress Bar -->
  <div class="absolute top-0 left-0 w-full h-1 bg-gray-200 dark:bg-gray-800">
    <div id="scroll-progress" class="h-full w-0 bg-gradient-to-r from-primary to-blue-600 transition-all duration-300"></div>
  </div>

  <nav class="max-w-6xl mx-auto bg-white/80 dark:bg-gray-900/80 backdrop-blur-lg rounded-2xl border border-gray-200 dark:border-gray-700 shadow-lg shadow-gray-200/20 dark:shadow-gray-900/20 transition-all duration-300">
    <div class="container mx-auto px-6">
      <div class="flex items-center justify-between h-16">
        <!-- Logo -->
        <a href={`/${lang}`} class="flex items-center group">
          <img 
            src="/logo.png" 
            alt="Logo" 
            width="200"
            height="200"
            class="w-[100px] h-[100px] object-contain transform transition-transform duration-300 group-hover:scale-110"
          />
        </a>

        <!-- Availability Badge -->
        <div class="hidden sm:block">
          <Availability />
        </div>
        
        <!-- Desktop Menu -->
        <div class="hidden xl:flex items-center space-x-1">
          {navItems.map(item => (
            <a
              href={item.href}
              class="group relative px-4 py-2 rounded-xl text-gray-600 dark:text-gray-300 hover:text-primary dark:hover:text-primary transition-colors overflow-hidden"
            >
              <span class="relative z-10 flex items-center gap-2">
                <Fragment set:html={item.icon} />
                {item.text}
              </span>
              <div class="absolute inset-0 bg-primary/5 dark:bg-primary/10 transform translate-y-full group-hover:translate-y-0 transition-transform duration-300 rounded-xl"></div>
            </a>
          ))}

          <!-- Tema ve Dil Seçici -->
          <div class="flex items-center gap-4 ml-4 pl-4 border-l border-gray-200 dark:border-gray-700">
            <!-- Tema Değiştirici -->
            <button
              id="theme-toggle"
              class="relative w-14 h-7 rounded-full bg-gray-200 dark:bg-gray-700 transition-all duration-300 hover:shadow-lg hover:shadow-primary/20 focus:outline-none focus:ring-2 focus:ring-primary/20 group"
              aria-label="Tema Değiştir"
            >
              <div
                id="theme-toggle-circle"
                class="absolute left-0.5 top-0.5 w-6 h-6 rounded-full bg-white dark:bg-primary transform transition-all duration-500 flex items-center justify-center"
              >
                <!-- Güneş İkonu -->
                <svg
                  id="theme-toggle-light-icon"
                  class="w-4 h-4 text-yellow-500 transition-all duration-500"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
                    clip-rule="evenodd"
                  />
                </svg>
                <!-- Ay İkonu -->
                <svg
                  id="theme-toggle-dark-icon"
                  class="absolute w-4 h-4 text-gray-800 opacity-0 transition-all duration-500"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" />
                </svg>
              </div>
              <span class="absolute inset-0 rounded-full overflow-hidden">
                <span class="absolute inset-0 bg-gradient-to-r from-yellow-400 to-orange-500 opacity-0 group-hover:opacity-10 dark:group-hover:opacity-20 transition-opacity duration-300"></span>
              </span>
            </button>

            <!-- Dil Seçici -->
            <div class="relative group" id="language-selector">
              <button
                class="flex items-center gap-2 px-3 py-1.5 rounded-lg text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-all duration-300"
              >
                <span class="text-xl">{languages.find(l => l.code === lang)?.flag}</span>
                <span class="font-medium uppercase">{lang}</span>
                <svg
                  class="w-4 h-4 transition-transform duration-300 group-hover:rotate-180"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div
                id="language-menu"
                class="absolute right-0 mt-2 w-48 py-2 bg-white dark:bg-gray-900 rounded-xl shadow-xl border border-gray-200 dark:border-gray-700 hidden group-hover:block transform transition-all duration-300 origin-top-right z-50"
              >
                {languages.map(l => (
                  <a
                    href={l.href}
                    class={`w-full px-4 py-2 text-left text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 flex items-center gap-2 transition-all duration-300 group ${l.code === lang ? 'bg-primary/5 dark:bg-primary/10 text-primary dark:text-primary' : ''}`}
                  >
                    <span class="text-lg group-hover:scale-110 transition-transform duration-300">{l.flag}</span>
                    <span class="group-hover:translate-x-1 transition-transform duration-300">{l.name}</span>
                  </a>
                ))}
              </div>
            </div>
          </div>


        </div>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-button"
          class="xl:hidden relative p-2 rounded-xl text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-all duration-300 hover:shadow-lg hover:shadow-primary/10 group"
          aria-label="Menu"
        >
          <svg
            id="menu-icon"
            class="w-6 h-6 transform group-hover:scale-110 transition-transform duration-300"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"
            />
          </svg>
          <svg
            id="close-icon"
            class="w-6 h-6 hidden transform group-hover:scale-110 transition-transform duration-300"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"
            />
          </svg>
          <div class="absolute inset-0 bg-primary/5 dark:bg-primary/10 rounded-xl transform scale-0 group-hover:scale-100 transition-transform duration-300"></div>
        </button>
      </div>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="hidden xl:hidden mt-4 bg-white dark:bg-gray-900 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-lg transform transition-all duration-300 origin-top"
  >
    <div class="container mx-auto px-4 py-4 space-y-2">
      {navItems.map(item => (
        <a
          href={item.href}
          class="flex items-center gap-3 px-4 py-3 text-gray-600 dark:text-gray-300 hover:text-primary dark:hover:text-primary hover:bg-gray-50 dark:hover:bg-gray-800 rounded-xl transition-all duration-300 group"
        >
          <span class="transform group-hover:scale-110 transition-transform duration-300">
            <Fragment set:html={item.icon} />
          </span>
          <span class="group-hover:translate-x-1 transition-transform duration-300">{item.text}</span>
        </a>
      ))}
      
      <!-- Mobil Tema ve Dil Seçici -->
      <div class="flex items-center gap-4 pt-4 mt-4 border-t border-gray-200 dark:border-gray-700">
        <button
          id="mobile-theme-toggle"
          class="flex items-center gap-2 w-full px-4 py-3 text-gray-600 dark:text-gray-300 hover:text-primary dark:hover:text-primary hover:bg-gray-50 dark:hover:bg-gray-800 rounded-xl transition-all duration-300 group"
        >
          <span class="transform group-hover:scale-110 transition-transform duration-300">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </span>
          <span class="group-hover:translate-x-1 transition-transform duration-300">Tema Değiştir</span>
        </button>

        <a
          href={languages.find(l => l.code !== lang)?.href || '#'}
          class="flex items-center gap-2 w-full px-4 py-3 text-gray-600 dark:text-gray-300 hover:text-primary dark:hover:text-primary hover:bg-gray-50 dark:hover:bg-gray-800 rounded-xl transition-all duration-300 group"
        >
          <span class="text-lg transform group-hover:scale-110 transition-transform duration-300">{languages.find(l => l.code !== lang)?.flag}</span>
          <span class="group-hover:translate-x-1 transition-transform duration-300">{languages.find(l => l.code !== lang)?.name}</span>
        </a>
      </div>


    </div>
  </div>
</div>

<style>
  /* Navbar scroll animasyonu */
  nav {
    transform: translateY(0);
    opacity: 1;
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  nav.nav-hidden {
    transform: translateY(-100%);
    opacity: 0;
  }

  nav.nav-scrolled {
    @apply shadow-xl;
    backdrop-filter: blur(12px);
  }

  /* Tema toggle animasyonları */
  #theme-toggle {
    overflow: hidden;
  }

  #theme-toggle-circle {
    transform-origin: center;
    will-change: transform;
  }

  #theme-toggle-circle svg {
    transform-origin: center;
    will-change: transform, opacity;
  }

  .dark #theme-toggle-circle {
    background-color: #3B82F6;
    transform: translateX(1.75rem) rotate(360deg);
  }

  /* İkon animasyonları */
  #theme-toggle-light-icon {
    transform: rotate(0deg) scale(1);
  }

  #theme-toggle-dark-icon {
    transform: rotate(-360deg) scale(0.5);
  }

  .dark #theme-toggle-light-icon {
    transform: rotate(360deg) scale(0.5);
  }

  .dark #theme-toggle-dark-icon {
    transform: rotate(0deg) scale(1);
  }

  /* Scroll progress bar */
  #scroll-progress {
    transition: width 0.1s ease-out;
  }
</style>

<script>
  // Scroll progress bar
  const progressBar = document.getElementById('scroll-progress');
  
  window.addEventListener('scroll', () => {
    const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
    const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    const scrolled = (winScroll / height) * 100;
    progressBar?.style.setProperty('width', `${scrolled}%`);
  });

  // Scroll olayını dinle
  let lastScroll = 0;
  const nav = document.querySelector('nav');
  
  window.addEventListener('scroll', () => {
    const currentScroll = window.pageYOffset;
    
    if (currentScroll <= 0) {
      nav?.classList.remove('nav-hidden');
      nav?.classList.remove('nav-scrolled');
    } else if (currentScroll > lastScroll) {
      nav?.classList.add('nav-hidden');
    } else {
      nav?.classList.remove('nav-hidden');
    }
    
    if (currentScroll > 10) {
      nav?.classList.add('nav-scrolled');
    } else {
      nav?.classList.remove('nav-scrolled');
    }
    
    lastScroll = currentScroll;
  });

  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  const toggleMenu = () => {
    mobileMenu?.classList.toggle('hidden');
    menuIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  };

  mobileMenuButton?.addEventListener('click', toggleMenu);

  // Menü öğelerine tıklandığında menüyü kapat
  const mobileMenuItems = mobileMenu?.querySelectorAll('a');
  mobileMenuItems?.forEach(item => {
    item.addEventListener('click', toggleMenu);
  });

  // Aktif bölüm takibi
  const sections = document.querySelectorAll('section[id]');
  const navLinks = document.querySelectorAll('nav a[href^="#"], nav a[href^="/#"]');

  const observerOptions = {
    root: null,
    rootMargin: '-50% 0px',
    threshold: 0
  };

  const observerCallback = (entries: IntersectionObserverEntry[]) => {
    entries.forEach((entry: IntersectionObserverEntry) => {
      if (entry.isIntersecting) {
        const id = entry.target.getAttribute('id');
        navLinks.forEach(link => {
          const href = link.getAttribute('href');
          if (href === `#${id}` || href === `/#${id}`) {
            link.classList.add('text-primary');
          } else {
            link.classList.remove('text-primary');
          }
        });
      }
    });
  };

  const observer = new IntersectionObserver(observerCallback, observerOptions);
  sections.forEach(section => observer.observe(section));

  // Sayfa yüklendiğinde ve kaydırıldığında navbar'ın arkaplan opaklığını ayarla
  const navbar = document.querySelector('nav');
  const updateNavbarOpacity = () => {
    if (window.scrollY > 0) {
      navbar?.classList.remove('bg-white/80', 'dark:bg-dark-bg/80');
      navbar?.classList.add('bg-white/95', 'dark:bg-dark-bg/95');
    } else {
      navbar?.classList.remove('bg-white/95', 'dark:bg-dark-bg/95');
      navbar?.classList.add('bg-white/80', 'dark:bg-dark-bg/80');
    }
  };

  window.addEventListener('scroll', updateNavbarOpacity);
  window.addEventListener('load', updateNavbarOpacity);

  // Tema değiştirici elementleri
  const themeToggleBtn = document.getElementById('theme-toggle');
  const themeToggleCircle = document.getElementById('theme-toggle-circle');
  const themeToggleDarkIcon = document.getElementById('theme-toggle-dark-icon');
  const themeToggleLightIcon = document.getElementById('theme-toggle-light-icon');
  const mobileThemeToggleBtn = document.getElementById('mobile-theme-toggle');

  // Başlangıç durumunu ayarla
  function updateThemeUI(isDark: boolean) {
    if (isDark) {
      themeToggleCircle?.classList.add('translate-x-6');
      themeToggleDarkIcon?.classList.remove('opacity-0');
      themeToggleLightIcon?.classList.add('opacity-0');
    } else {
      themeToggleCircle?.classList.remove('translate-x-6');
      themeToggleDarkIcon?.classList.add('opacity-0');
      themeToggleLightIcon?.classList.remove('opacity-0');
    }
  }

  // Başlangıçta tema durumunu kontrol et
  updateThemeUI(document.documentElement.classList.contains('dark'));

  // Tema değiştirme fonksiyonu
  function handleThemeToggle() {
    const element = document.documentElement;
    const isDark = element.classList.toggle('dark');
    
    updateThemeUI(isDark);
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  }

  // Event listener ekle
  themeToggleBtn?.addEventListener('click', handleThemeToggle);
  mobileThemeToggleBtn?.addEventListener('click', handleThemeToggle);

  // Dil seçici
  const languageSelector = document.getElementById('language-selector');
  const languageMenu = document.getElementById('language-menu');

  languageSelector?.addEventListener('click', (e) => {
    e.stopPropagation();
    languageMenu?.classList.toggle('hidden');
  });

  document.addEventListener('click', () => {
    languageMenu?.classList.add('hidden');
  });
</script>
 