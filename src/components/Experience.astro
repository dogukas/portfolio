---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { data } from '../i18n/data';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { experiences } = data[lang];
---

<section id="experience" class="py-20 lg:py-32 relative overflow-hidden">
  <!-- Arkaplan Deseni -->
  <div class="absolute inset-0 opacity-10 dark:opacity-5">
    <div class="absolute inset-0 bg-gradient-to-b from-primary/20 via-transparent to-primary/20"></div>
    <div class="absolute inset-y-0 left-0 w-1/2 bg-gradient-to-r from-primary/10 to-transparent"></div>
    <div class="absolute inset-y-0 right-0 w-1/2 bg-gradient-to-l from-primary/10 to-transparent"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(var(--color-primary-rgb),0.1)_0%,transparent_70%)]"></div>
  </div>

  <div class="container mx-auto px-4 relative">
    <div class="max-w-6xl mx-auto">
      <!-- Başlık -->
      <div class="text-center mb-16" data-aos="fade-up">
        <div class="inline-block relative">
          <span class="inline-block px-3 py-1 bg-primary/10 text-primary rounded-lg text-sm font-medium mb-4 relative z-10">
            {t('experience.title').toUpperCase()}
          </span>
          <div class="absolute -inset-2 bg-gradient-to-r from-primary/20 via-primary/10 to-primary/20 blur-lg opacity-50 rounded-lg"></div>
        </div>
        <h2 class="text-4xl lg:text-6xl font-bold mb-6 bg-gradient-to-r from-gray-900 to-gray-600 dark:from-white dark:to-gray-300 bg-clip-text text-transparent">
          {t('experience.desc')}
        </h2>
        <p class="text-gray-600 dark:text-gray-300 max-w-2xl mx-auto text-lg leading-relaxed">
           
        </p>
      </div>

      <!-- Deneyim Timeline -->
      <div class="relative">
        <!-- Timeline Çizgisi -->
        <div class="absolute left-0 md:left-1/2 transform md:-translate-x-1/2 h-full w-1 bg-gradient-to-b from-primary/50 via-primary/20 to-transparent rounded-full"></div>

        <!-- Deneyimler -->
        <div class="space-y-12">
          {experiences.map((exp, index) => (
            <div class="relative group" data-aos={index % 2 === 0 ? "fade-right" : "fade-left"}>
              <!-- Zaman Noktası -->
              <div class="absolute left-0 md:left-1/2 transform md:-translate-x-1/2 -translate-y-1/4 w-4 h-4">
                <div class="absolute inset-0 bg-primary rounded-full animate-ping opacity-20"></div>
                <div class="absolute inset-0.5 bg-white dark:bg-gray-800 rounded-full"></div>
                <div class="absolute inset-1 bg-gradient-to-r from-primary to-primary-dark rounded-full group-hover:scale-125 transition-transform duration-300"></div>
              </div>

              <!-- Deneyim Kartı -->
              <div class={`relative ml-8 md:ml-0 ${index % 2 === 0 ? 'md:mr-[50%] md:pr-12' : 'md:ml-[50%] md:pl-12'}`}>
                <div class="relative group/card">
                  <!-- Kart Arkaplan Efekti -->
                  <div class="absolute -inset-2 bg-gradient-to-r from-primary/30 via-primary/20 to-primary/30 rounded-2xl blur opacity-0 group-hover/card:opacity-75 transition duration-300"></div>
                  
                  <!-- Kart İçeriği -->
                  <div class="relative bg-white dark:bg-gray-800/50 backdrop-blur-xl rounded-xl p-8 ring-1 ring-gray-200/50 dark:ring-gray-700/50">
                    <!-- Başlık ve Şirket -->
                    <div class="flex flex-wrap items-center justify-between mb-4">
                      <h3 class="text-2xl font-bold bg-gradient-to-r from-gray-900 to-gray-600 dark:from-white dark:to-gray-300 bg-clip-text text-transparent">{exp.title}</h3>
                      <span class="text-primary font-medium">{exp.period}</span>
                    </div>
                    
                    <div class="flex flex-wrap gap-4 mb-4">
                      <div class="flex items-center text-gray-600 dark:text-gray-300">
                        <span class="mr-2">🏢</span>
                        {exp.company}
                      </div>
                      <div class="flex items-center text-gray-600 dark:text-gray-300">
                        <span class="mr-2">📍</span>
                        {exp.location}
                      </div>
                      <div class="flex items-center text-gray-600 dark:text-gray-300">
                        <span class="mr-2">⏰</span>
                        {exp.type}
                      </div>
                    </div>

                    <p class="text-gray-600 dark:text-gray-300 mb-6">{exp.description}</p>

                    <!-- Öne Çıkanlar -->
                    <div class="space-y-2 mb-6">
                      {exp.highlights.map(highlight => (
                        <div class="flex items-start group/highlight">
                          <span class="text-primary mr-2 transform group-hover/highlight:scale-125 transition-transform">✓</span>
                          <span class="text-gray-600 dark:text-gray-300 group-hover/highlight:text-primary transition-colors">{highlight}</span>
                        </div>
                      ))}
                    </div>

                    <!-- Teknolojiler -->
                    <div class="flex flex-wrap gap-2">
                      {exp.tech.map(tech => (
                        <span class={`px-3 py-1 rounded-full text-sm font-medium bg-gradient-to-r ${exp.color} text-white transform hover:scale-105 transition-transform`}>
                          {tech}
                        </span>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- CTA -->
      <div class="mt-16 text-center" data-aos="fade-up">
        <div class="relative inline-block group">
          <div class="absolute -inset-2 bg-gradient-to-r from-primary/30 via-primary/20 to-primary/30 rounded-xl blur opacity-0 group-hover:opacity-75 transition duration-300"></div>
          <a 
            href="/resume.pdf" 
            class="relative inline-flex items-center px-6 py-3 bg-white dark:bg-gray-800 rounded-lg ring-1 ring-gray-200/50 dark:ring-gray-700/50 hover:ring-primary/50 transition-all duration-300"
          >
            <span class="text-lg font-medium bg-gradient-to-r from-gray-900 to-gray-600 dark:from-white dark:to-gray-300 bg-clip-text text-transparent mr-2">
              Özgeçmişimi İndir
            </span>
            <span class="text-primary text-xl">↓</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes ping {
    75%, 100% {
      transform: scale(2);
      opacity: 0;
    }
  }

  .animate-ping {
    animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
</style> 