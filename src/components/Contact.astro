---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const contactInfo = {
  email: "*****@email.com",
  phone: "+90 5*********",
  location: "Samsun, Türkiye",
  location2: "Hannover, Germany",
  socials: [
    {
      name: "GitHub",
      url: "",
      icon: `<path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>`
    },
    {
      name: "LinkedIn",
      url: "https://www.linkedin.com/in/do%C4%9Fukan-tevfik-sa%C4%9F%C4%B1ro%C4%9Flu-a82754299/",
      icon: `<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>`
    },
    {
      name: "Twitter",
      url: "",
      icon: `<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>`
    }
  ]
};
---

<section id="contact" class="py-20 lg:py-32 relative overflow-hidden">
  <!-- Arkaplan Deseni -->
  <div class="absolute inset-0 opacity-10 dark:opacity-5">
    <div class="absolute inset-0 bg-gradient-to-r from-primary/20 via-transparent to-primary/20"></div>
    <div class="absolute inset-y-0 left-0 w-1/2 bg-gradient-to-r from-primary/10 to-transparent"></div>
    <div class="absolute inset-y-0 right-0 w-1/2 bg-gradient-to-l from-primary/10 to-transparent"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(var(--color-primary-rgb),0.1)_0%,transparent_100%)]"></div>
  </div>

  <div class="container mx-auto px-4 relative">
    <div class="max-w-6xl mx-auto">
      <!-- Başlık -->
      <div class="text-center mb-16" data-aos="fade-up">
        <div class="inline-block relative">
          <span class="inline-block px-3 py-1 bg-primary/10 text-primary rounded-lg text-sm font-medium mb-4 relative z-10">
            {t('contact.title').toUpperCase()}
          </span>
          <div class="absolute -inset-2 bg-gradient-to-r from-primary/20 via-primary/10 to-primary/20 blur-lg opacity-50 rounded-lg"></div>
        </div>
        <h2 class="text-4xl lg:text-6xl font-bold mb-6 bg-gradient-to-r from-gray-900 to-gray-600 dark:from-white dark:to-gray-300 bg-clip-text text-transparent">
          {t('contact.title')}
        </h2>
        <p class="text-gray-600 dark:text-gray-300 max-w-2xl mx-auto text-lg leading-relaxed">
          {t('contact.desc')}
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-12">
        <!-- İletişim Formu -->
        <div class="relative" data-aos="fade-right">
          <div class="absolute -inset-2 bg-gradient-to-r from-primary/30 via-primary/20 to-primary/30 rounded-2xl blur opacity-0 group-hover:opacity-75 transition duration-300"></div>
          <div class="relative bg-white dark:bg-gray-800/50 backdrop-blur-xl rounded-2xl p-8 ring-1 ring-gray-200/50 dark:ring-gray-700/50">
            <form id="contact-form" class="space-y-6">
              <div>
                <label for="name" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                  {t('contact.name')}
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary dark:bg-gray-800 dark:text-white"
                />
              </div>
              
              <div>
                <label for="email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                  {t('contact.email')}
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary dark:bg-gray-800 dark:text-white"
                />
              </div>
              
              <div>
                <label for="message" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                  {t('contact.message')}
                </label>
                <textarea
                  id="message"
                  name="message"
                  rows="4"
                  required
                  class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary dark:bg-gray-800 dark:text-white"
                ></textarea>
              </div>
              
              <button
                type="submit"
                class="w-full bg-primary text-white py-3 px-6 rounded-lg hover:bg-primary/90 transition-colors duration-300 font-medium"
              >
                {t('contact.send')}
              </button>
            </form>
            
            <!-- Success/Error Messages -->
            <div id="success-message" class="hidden mt-4 p-4 bg-green-100 text-green-700 rounded-lg">
              {t('contact.success')}
            </div>
            <div id="error-message" class="hidden mt-4 p-4 bg-red-100 text-red-700 rounded-lg">
              {t('contact.error')}
            </div>
          </div>
        </div>

        <!-- İletişim Bilgileri -->
        <div class="space-y-8" data-aos="fade-left">
          <!-- Email -->
          <div class="relative group">
            <div class="absolute -inset-2 bg-gradient-to-r from-primary/30 via-primary/20 to-primary/30 rounded-2xl blur opacity-0 group-hover:opacity-75 transition duration-300"></div>
            <div class="relative bg-white dark:bg-gray-800/50 backdrop-blur-xl rounded-2xl p-6 ring-1 ring-gray-200/50 dark:ring-gray-700/50 flex items-center">
              <div class="w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center mr-6">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-1">Email</h3>
                <a href={`mailto:${contactInfo.email}`} class="text-gray-600 dark:text-gray-300 hover:text-primary transition-colors">
                  {contactInfo.email}
                </a>
              </div>
            </div>
          </div>

          <!-- Telefon -->
          <div class="relative group">
            <div class="absolute -inset-2 bg-gradient-to-r from-primary/30 via-primary/20 to-primary/30 rounded-2xl blur opacity-0 group-hover:opacity-75 transition duration-300"></div>
            <div class="relative bg-white dark:bg-gray-800/50 backdrop-blur-xl rounded-2xl p-6 ring-1 ring-gray-200/50 dark:ring-gray-700/50 flex items-center">
              <div class="w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center mr-6">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-1">Telefon</h3>
                <a href={`tel:${contactInfo.phone}`} class="text-gray-600 dark:text-gray-300 hover:text-primary transition-colors">
                  {contactInfo.phone}
                </a>
              </div>
            </div>
          </div>

          <!-- Konum -->
          <div class="relative group">
            <div class="absolute -inset-2 bg-gradient-to-r from-primary/30 via-primary/20 to-primary/30 rounded-2xl blur opacity-0 group-hover:opacity-75 transition duration-300"></div>
            <div class="relative bg-white dark:bg-gray-800/50 backdrop-blur-xl rounded-2xl p-6 ring-1 ring-gray-200/50 dark:ring-gray-700/50 flex items-center">
              <div class="w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center mr-6">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-1">Konum</h3>
                <p class="text-gray-600 dark:text-gray-300">
                  {contactInfo.location} | {contactInfo.location2}
                </p>
              </div>
            </div>
          </div>

          <!-- Sosyal Medya -->
          <div class="flex gap-4 mt-8">
            {contactInfo.socials.map(social => (
              <a 
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                class="w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center text-primary hover:bg-primary hover:text-white transition-colors"
              >
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
                  <Fragment set:html={social.icon} />
                </svg>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import emailjs from '@emailjs/browser';
  
  // EmailJS'yi başlat
  emailjs.init("6lFsh6166stgWmNOz"); 
  
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successMessage = document.getElementById('success-message');
  const errorMessage = document.getElementById('error-message');
  
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    // Loading durumunu göster
    const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const originalButtonText = submitButton.textContent;
    submitButton.textContent = 'Gönderiliyor...';
    submitButton.disabled = true;
    
    try {
      // Form verilerini al
      const formData = {
        name: (form.querySelector('#name') as HTMLInputElement).value,
        email: (form.querySelector('#email') as HTMLInputElement).value,
        message: (form.querySelector('#message') as HTMLTextAreaElement).value,
      };
      
      // EmailJS ile mail gönder
      await emailjs.send(
        'service_vas6d89',
        'template_wqlwqob',
        formData
      );
      
      // Başarılı mesajını göster
      if (successMessage && errorMessage) {
        successMessage.classList.remove('hidden');
        errorMessage.classList.add('hidden');
      }
      
      // Formu temizle
      form.reset();
      
    } catch (error) {
      // Hata mesajını göster
      if (successMessage && errorMessage) {
        successMessage.classList.add('hidden');
        errorMessage.classList.remove('hidden');
      }
      console.error('Email sending failed:', error);
    } finally {
      // Submit butonunu eski haline getir
      submitButton.textContent = originalButtonText;
      submitButton.disabled = false;
    }
  });
</script>

<style>
  @keyframes float {
    0% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
    100% {
      transform: translateY(0);
    }
  }

  @keyframes pulse {
    0% {
      transform: scale(1);
      opacity: 0.8;
    }
    50% {
      transform: scale(1.05);
      opacity: 0.6;
    }
    100% {
      transform: scale(1);
      opacity: 0.8;
    }
  }

  @keyframes borderGlow {
    0% {
      box-shadow: 0 0 5px rgba(var(--color-primary-rgb), 0.2);
    }
    50% {
      box-shadow: 0 0 20px rgba(var(--color-primary-rgb), 0.4);
    }
    100% {
      box-shadow: 0 0 5px rgba(var(--color-primary-rgb), 0.2);
    }
  }

  .contact-card {
    transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .contact-card:hover {
    animation: float 6s infinite ease-in-out;
  }

  .contact-icon {
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .contact-card:hover .contact-icon {
    transform: scale(1.2) rotate(10deg);
    animation: pulse 2s infinite ease-in-out;
  }

  input, textarea {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  input:focus, textarea:focus {
    transform: translateY(-2px);
    animation: borderGlow 2s infinite ease-in-out;
  }

  .social-icon {
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .social-icon:hover {
    transform: scale(1.2) rotate(10deg);
    animation: pulse 2s infinite ease-in-out;
  }

  .submit-button {
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .submit-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px -10px rgba(var(--color-primary-rgb), 0.5);
  }

  .submit-button:hover svg {
    animation: float 1s infinite ease-in-out;
  }

  input::placeholder,
  textarea::placeholder {
    color: #9CA3AF;
    transition: color 0.3s ease;
  }

  .dark input::placeholder,
  .dark textarea::placeholder {
    color: #6B7280;
  }

  input:focus::placeholder,
  textarea:focus::placeholder {
    opacity: 0.7;
    transform: translateX(10px);
    transition: all 0.3s ease;
  }

  .gradient-bg {
    background: linear-gradient(
      120deg,
      rgba(var(--color-primary-rgb), 0.1),
      rgba(var(--color-primary-rgb), 0.05),
      rgba(var(--color-primary-rgb), 0.1)
    );
    background-size: 200% 200%;
    animation: gradientMove 15s infinite linear;
  }

  @keyframes gradientMove {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }
</style> 