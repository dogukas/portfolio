```
---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  
  // Tüm postları tüm diller için oluştur
  const paths = [];
  ['tr', 'de'].forEach(lang => {
    posts.forEach(post => {
      paths.push({
        params: { lang, slug: post.slug },
        props: { post, lang },
      });
    });
  });

  return paths;
}

const { post, lang } = Astro.props;
const { Content } = await post.render();
const t = useTranslations(lang as "tr" | "de");

const dateLocale = lang === 'tr' ? 'tr-TR' : 'de-DE';
---

<Layout title={`${post.data.title} - Dogukan Sagiroglu`}>
  <article class="pt-24 pb-12 bg-white dark:bg-gray-900 min-h-screen">
    <!-- Hero Image -->
    <div class="h-[40vh] w-full relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-transparent to-transparent z-10"></div>
      <img 
        src={post.data.image} 
        alt={post.data.title} 
        class="w-full h-full object-cover"
        transition:name={`image-${post.slug}`}
      />
      
      <div class="absolute bottom-0 left-0 w-full z-20 p-4 md:p-8 lg:p-12">
        <div class="container mx-auto max-w-4xl">
          <div class="flex gap-2 mb-4">
            {post.data.tags.map(tag => (
              <span class="px-3 py-1 bg-primary text-white text-sm rounded-full font-medium shadow-lg">
                {tag}
              </span>
            ))}
          </div>
          <h1 class="text-3xl md:text-5xl font-bold text-white mb-4 leading-tight shadow-black/50 drop-shadow-lg">
            {post.data.title}
          </h1>
          <div class="flex items-center gap-4 text-gray-200 text-sm md:text-base">
            <div class="flex items-center gap-2">
              <div class="w-8 h-8 rounded-full bg-white/20 backdrop-blur-md flex items-center justify-center font-bold">
                {post.data.author[0]}
              </div>
              <span>{post.data.author}</span>
            </div>
            <span>•</span>
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString(dateLocale, { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
          </div>
        </div>
      </div>
    </div>

    <!-- Content -->
    <div class="container mx-auto px-4 py-12 max-w-4xl">
      <div class="prose prose-lg dark:prose-invert max-w-none prose-headings:text-gray-900 dark:prose-headings:text-white prose-p:text-gray-600 dark:prose-p:text-gray-300 prose-a:text-primary hover:prose-a:text-primary-dark">
        <Content />
      </div>

      <!-- Navigation -->
      <div class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-800">
        <a 
          href={`/${lang}/blog`}
          class="inline-flex items-center gap-2 text-gray-600 dark:text-gray-400 hover:text-primary dark:hover:text-primary transition-colors group"
        >
          <svg class="w-5 h-5 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          {t('blog.back')}
        </a>
      </div>
    </div>
  </article>
</Layout>  
```
